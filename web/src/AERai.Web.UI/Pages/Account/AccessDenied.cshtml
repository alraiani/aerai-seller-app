@page
@model AERai.Web.UI.Pages.Account.AccessDeniedModel
@{
    ViewData["Title"] = "Access denied";
}
<div class="card">
    <div class="card-body">
        <h2 class="h5">You don't have access to this page</h2>
        <p class="mb-3">Your role doesn't include this area. Ask an administrator if you need access.</p>
        <a asp-page="/Index" class="btn btn-primary">Back to dashboard</a>
    </div>
</div>
