@page
@using AERai.Web.Domain.Staging
@model AERai.Web.UI.Pages.Tools.ImportModel
@{
    ViewData["Title"] = "Import data";
}
<div class="row g-3">
    <div class="col-lg-6">
        <div class="card">
            <div class="card-body">
                <form method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="All" class="alert alert-danger py-2"></div>
                    <div class="mb-3">
                        <label asp-for="Input.Source" class="form-label"></label>
                        <select asp-for="Input.Source" asp-items="Html.GetEnumSelectList<ImportSource>()" class="form-select"></select>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Input.MarketplaceId" class="form-label"></label>
                        <select asp-for="Input.MarketplaceId" asp-items="@(new SelectList(Model.Marketplaces, "MarketplaceId", "Name"))" class="form-select"></select>
                        <div class="form-text">Every row in the file is recorded under this marketplace.</div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Input.File" class="form-label"></label>
                        <input asp-for="Input.File" type="file" class="form-control" accept="@string.Join(",", Model.Limits.AllowedExtensions)" />
                        <div class="form-text">
                            @string.Join(", ", Model.Limits.AllowedExtensions) · up to @(Model.Limits.MaxFileBytes / (1024 * 1024)) MB
                            and @Model.Limits.MaxRows.ToString("N0") rows. Comma- or tab-delimited with a header row.
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary">Upload</button>
                </form>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card">
            <div class="card-header">How imports work</div>
            <div class="card-body small">
                <ol class="mb-3">
                    <li><strong>Land</strong> — the original file is stored untouched in the raw blob container (the landing zone), so it can always be re-staged.</li>
                    <li><strong>Stage</strong> — the stored file is parsed and every row lands as raw text in the <code>stg</code> (staging) schema.</li>
                    <li><strong>Promote</strong> — from the batch page, rows are validated, typed, and merged into the curated <code>core</code> tables. Bad rows are skipped and listed with a reason.</li>
                    <li><strong>Report</strong> — pages read the <code>rpt</code> views built on <code>core</code>.</li>
                </ol>
                <p class="mb-1"><strong>Required columns</strong></p>
                <ul class="mb-0">
                    <li>Orders: amazon-order-id, purchase-date, order-status, sku, quantity, item-price (optional: asin, product-name, currency, sales-channel)</li>
                    <li>Inventory: snapshot-date, sku, state, quantity (optional: asin, product-name)</li>
                    <li>Settlements: settlement-id, transaction-type, amount (plus the standard V2 flat-file columns)</li>
                </ul>
            </div>
        </div>
    </div>
</div>
