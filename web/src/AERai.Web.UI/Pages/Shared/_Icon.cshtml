@model string
@* Small stroke icons (Lucide-style geometry) inlined as SVG so they inherit currentColor and need no icon font. *@
<svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
@switch (Model)
{
    case "plus":
        <path d="M12 5v14M5 12h14" />
        break;
    case "edit":
        <path d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z" />
        break;
    case "play":
        <path d="M7 4v16l13-8Z" />
        break;
    case "more":
        <circle cx="5" cy="12" r="1" />
        <circle cx="12" cy="12" r="1" />
        <circle cx="19" cy="12" r="1" />
        break;
    case "trash":
        <path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6M10 11v6M14 11v6" />
        break;
    case "copy":
        <rect x="9" y="9" width="12" height="12" rx="2" />
        <path d="M5 15H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v1" />
        break;
    case "history":
        <path d="M3 12a9 9 0 1 0 3-6.7L3 8M3 3v5h5M12 7v5l3 3" />
        break;
    case "rewind":
        <path d="M11 19 2 12l9-7v14ZM22 19l-9-7 9-7v14Z" />
        break;
    case "restore":
        <path d="M3 12a9 9 0 1 0 3-6.7L3 8M3 3v5h5" />
        break;
    case "pause":
        <path d="M8 5v14M16 5v14" />
        break;
    case "search":
        <circle cx="11" cy="11" r="7" />
        <path d="m20 20-3.5-3.5" />
        break;
    case "plug":
        <path d="M9 2v6M15 2v6M6 8h12v4a6 6 0 0 1-12 0ZM12 18v4" />
        break;
    case "note":
        <circle cx="12" cy="12" r="9" />
        <path d="M12 16v-4M12 8h.01" />
        break;
    case "check":
        <path d="M20 6 9 17l-5-5" />
        break;
    case "x":
        <path d="M18 6 6 18M6 6l12 12" />
        break;
    case "user":
        <circle cx="12" cy="8" r="4" />
        <path d="M4 21a8 8 0 0 1 16 0" />
        break;
    case "help":
        <circle cx="12" cy="12" r="9" />
        <path d="M9.5 9a2.5 2.5 0 1 1 3.5 2.3c-.6.3-1 .9-1 1.6v.6M12 17h.01" />
        break;
    case "tag":
        <path d="M20.6 13.4 13.4 20.6a2 2 0 0 1-2.8 0L3 13V3h10l7.6 7.6a2 2 0 0 1 0 2.8Z" />
        <circle cx="7.5" cy="7.5" r="1.5" />
        break;
    case "box":
        <path d="M21 8 12 3 3 8v8l9 5 9-5ZM3 8l9 5 9-5M12 13v8" />
        break;
    case "upload":
        <path d="M12 15V3M7 8l5-5 5 5M4 15v4a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-4" />
        break;
    case "bell":
        <path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9M10.3 21a1.9 1.9 0 0 0 3.4 0" />
        break;
    case "refresh":
        <path d="M21 12a9 9 0 0 1-15.5 6.2L3 16M3 12a9 9 0 0 1 15.5-6.2L21 8M21 3v5h-5M3 21v-5h5" />
        break;
}
</svg>
