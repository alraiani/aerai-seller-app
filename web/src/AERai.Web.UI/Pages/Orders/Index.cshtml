@page
@model AERai.Web.UI.Pages.Orders.IndexModel
@{
    ViewData["Title"] = "Orders";
}
<partial name="_SearchForm" model="Model.Search" />
<div class="card">
    <div class="card-body p-0">
        <table class="table table-sm table-hover mb-0">
            <thead>
                <tr><th>Order</th><th>Purchased (UTC)</th><th>Status</th><th class="text-end">Lines</th><th class="text-end">Units</th><th class="text-end">Total</th></tr>
            </thead>
            <tbody>
            @foreach (var o in Model.Orders.Items)
            {
                <tr>
                    <td>@o.AmazonOrderId</td>
                    <td>@o.PurchaseDate.ToUniversalTime().ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@o.OrderStatus</td>
                    <td class="text-end">@o.LineCount</td>
                    <td class="text-end">@o.Units</td>
                    <td class="text-end">@o.OrderTotal.ToString("N2") @o.Currency</td>
                </tr>
            }
            @if (Model.Orders.Items.Count == 0)
            {
                <tr><td colspan="6" class="text-body-secondary p-3">No orders found.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
<partial name="_Pager" model="Model.Orders.ToPager(Model.Search)" />
