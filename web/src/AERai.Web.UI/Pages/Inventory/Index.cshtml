@page
@model AERai.Web.UI.Pages.Inventory.IndexModel
@{
    ViewData["Title"] = "Inventory";
}
<partial name="_SearchForm" model="Model.Search" />
<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
        <table class="table table-sm table-hover mb-0">
            <thead>
                <tr>
                    <th>SKU</th><th>Title</th><th>Snapshot</th>
                    <th class="text-end">Available</th><th class="text-end">Inbound</th>
                    <th class="text-end">Reserved</th><th class="text-end">Unfulfillable</th>
                    <th class="text-end">Sold (30d)</th><th class="text-end">Per day</th><th class="text-end">Days of supply</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var p in Model.Positions.Items)
            {
                <tr>
                    <td>@p.Sku</td>
                    <td class="cell-truncate" title="@p.Title">@p.Title</td>
                    <td class="text-nowrap">@p.SnapshotDate.ToString("yyyy-MM-dd")</td>
                    <td class="text-end">@p.Available.ToString("N0")</td>
                    <td class="text-end">@p.Inbound.ToString("N0")</td>
                    <td class="text-end">@p.Reserved.ToString("N0")</td>
                    <td class="text-end">@p.Unfulfillable.ToString("N0")</td>
                    <td class="text-end">@p.UnitsSold30d.ToString("N0")</td>
                    <td class="text-end">@p.DailyVelocity.ToString("0.00")</td>
                    <td class="text-end">@(p.DaysOfSupply?.ToString("0.0") ?? "—")</td>
                </tr>
            }
            @if (Model.Positions.Items.Count == 0)
            {
                <tr><td colspan="10" class="text-body-secondary p-3">No inventory yet. Import an inventory file from Tools.</td></tr>
            }
            </tbody>
        </table>
        </div>
    </div>
</div>
<partial name="_Pager" model="Model.Positions.ToPager(Model.Search)" />
