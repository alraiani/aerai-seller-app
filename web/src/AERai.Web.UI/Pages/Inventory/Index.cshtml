@page
@using System.Globalization
@using AERai.Web.Application.Inventory
@model AERai.Web.UI.Pages.Inventory.IndexModel
@{
    ViewData["Title"] = "Inventory";
    var en = CultureInfo.GetCultureInfo("en-US");
    var t = Model.Overview.Totals;
    var tiles = new (string Label, string Tip, int Value)[]
    {
        ("Sellable", "Units available to buy right now.", t.Available),
        ("Inbound", "Units on shipment plans, in transit, or being received at a fulfillment center.", t.Inbound),
        ("In warehouse", "Units inside Amazon's fulfillment centers: sellable, reserved, and unfulfillable.", t.InWarehouse),
        ("Total at Amazon", "Every unit Amazon reports: in the warehouse plus inbound.", t.AmazonTotal),
        ("Home stock", "Units you hold outside Amazon for this marketplace, entered by hand or uploaded.", t.HomeStock),
        ("Overall", "Everything you own for this marketplace: total at Amazon plus home stock.", t.OverallTotal),
    };
}
<div class="list-toolbar mb-3">
    <form method="get" class="filters" role="search">
        <input type="search" name="q" value="@Model.Search" class="form-control form-control-sm search-input" placeholder="SKU, ASIN, name, or family…" aria-label="Search" />
        <select name="family" class="form-select form-select-sm w-auto" aria-label="Family">
            <option value="">All families</option>
            @foreach (var f in Model.Families)
            {
                <option value="@f.Id" selected="@(Model.FamilyId == f.Id)">@f.Name</option>
            }
        </select>
        <button type="submit" class="btn btn-sm btn-outline-primary">Filter</button>
    </form>
    @if (Model.CanEdit)
    {
        <div class="list-actions">
            <a asp-page="HomeStock/Index" class="btn btn-sm btn-soft">Edit home stock</a>
            <a asp-page="HomeStock/Upload" class="btn btn-sm btn-soft">Upload home stock</a>
        </div>
    }
</div>
<p class="text-muted-token small mb-2">
    @t.SkuCount.ToString("N0", en) SKU@(t.SkuCount == 1 ? "" : "s") in @Model.Marketplace.Name@(t.SnapshotDate is { } d ? $" · Amazon snapshot {d.ToString("MMM d", en)}" : "")
</p>

<div class="row g-3 mb-3">
    @foreach (var tile in tiles)
    {
        <div class="col-6 col-md-4 col-xl-2">
            <div class="card h-100">
                <div class="kpi">
                    <div class="kpi-label">@tile.Label <partial name="_Tip" model="tile.Tip" /></div>
                    <div class="kpi-value kpi-value-sm">@tile.Value.ToString("N0", en)</div>
                </div>
            </div>
        </div>
    }
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
        <table class="table table-sm table-hover mb-0 inventory-table">
            <thead>
                <tr>
                    <th rowspan="2" colspan="2">Product</th>
                    <th rowspan="2" class="text-end">Available</th>
                    <th colspan="3" class="th-group">Inbound <partial name="_Tip" model='"Working: on a shipment plan, not shipped. Shipped: in transit. Receiving: arrived and being checked in."' /></th>
                    <th colspan="3" class="th-group">Reserved <partial name="_Tip" model='"Customer orders: sold, waiting to ship. FC transfer: moving between fulfillment centers. Processing: held for measuring or investigation."' /></th>
                    <th rowspan="2" class="text-end">Unfulfillable</th>
                    <th rowspan="2" class="text-end">Home stock</th>
                    <th rowspan="2" class="text-end col-divider">Sold 30d</th>
                    <th rowspan="2" class="text-end">Sold 90d</th>
                    <th rowspan="2" class="text-end">Per day <partial name="_Tip" model="@($"Units sold in the last {InventoryService.VelocityWindowDays} days divided by the days covered since the first sale in that window. Blank until there are {InventoryService.MinCoverageDays} days and {InventoryService.MinUnitsSold} units of history.")" /></th>
                    <th rowspan="2" class="text-end">Days of inventory <partial name="_Tip" model='"How long sellable, inbound, and FC-transfer/processing stock lasts at the current sales rate. Home stock is not counted."' /></th>
                    <th rowspan="2" class="col-divider">Restock <partial name="_Tip" model='"What to do to stay in stock: send home stock first, order the rest from your supplier, each by the last day it can still arrive before the safety buffer runs out. Quantities top stock up to the target cover. Set lead times per SKU with Edit."' /></th>
                    @if (Model.CanEdit)
                    {
                        <th rowspan="2"></th>
                    }
                </tr>
                <tr>
                    <th class="text-end">Working</th><th class="text-end">Shipped</th><th class="text-end">Receiving</th>
                    <th class="text-end">Customer orders</th><th class="text-end">FC transfer</th><th class="text-end">Processing</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model.Overview.Items.Items)
            {
                var p = item.Position;
                <tr>
                    <td class="thumb-cell">
                        @if (p.ImagePath is { } image)
                        {
                            <img class="product-thumb" src="@Url.Page("Image", new { sku = p.Sku, v = System.IO.Path.GetFileNameWithoutExtension(image) })" alt="" loading="lazy" width="40" height="40" />
                        }
                        else
                        {
                            <span class="product-thumb product-thumb-empty" aria-hidden="true"></span>
                        }
                    </td>
                    <td>
                        <div class="product-title" title="@p.Title">@(p.Title ?? p.Sku)</div>
                        <div class="product-sku">@p.Sku@(p.Asin is { } asin ? $" · {asin}" : "")@(p.Family is { } family ? $" · {family}" : "")</div>
                    </td>
                    @if (p.SnapshotDate is null)
                    {
                        <td colspan="8" class="text-end cell-sub">Not at Amazon yet</td>
                    }
                    else
                    {
                        <td class="text-end fw-semibold">@p.Available.ToString("N0", en)</td>
                        @if (p.HasInboundBreakdown)
                        {
                            <td class="text-end">@p.InboundWorking.ToString("N0", en)</td>
                            <td class="text-end">@p.InboundShipped.ToString("N0", en)</td>
                            <td class="text-end">@p.InboundReceiving.ToString("N0", en)</td>
                        }
                        else
                        {
                            <td colspan="3" class="text-end">@p.Inbound.ToString("N0", en) <span class="cell-sub">no breakdown</span></td>
                        }
                        @if (p.HasReservedBreakdown)
                        {
                            <td class="text-end">@p.ReservedCustomerOrder.ToString("N0", en)</td>
                            <td class="text-end">@p.ReservedFcTransfer.ToString("N0", en)</td>
                            <td class="text-end">@p.ReservedFcProcessing.ToString("N0", en)</td>
                        }
                        else
                        {
                            <td colspan="3" class="text-end">@p.Reserved.ToString("N0", en) <span class="cell-sub">no breakdown</span></td>
                        }
                        <td class="text-end">@p.Unfulfillable.ToString("N0", en)</td>
                    }
                    <td class="text-end">@p.HomeStock.ToString("N0", en)</td>
                    <td class="text-end col-divider">@item.UnitsSold30d.ToString("N0", en)</td>
                    <td class="text-end">@item.UnitsSold90d.ToString("N0", en)</td>
                    <td class="text-end">@(item.DailyVelocity?.ToString("0.00", en) ?? "—")</td>
                    <td class="text-end">@(item.DaysOfInventory?.ToString("N1", en) ?? "—")</td>
                    <td class="col-divider restock-cell">
                        @if (item.Restock is not { } plan)
                        {
                            <span class="cell-sub" title="Needs @InventoryService.MinCoverageDays days and @InventoryService.MinUnitsSold units of sales history.">Not enough sales data</span>
                        }
                        else if (plan.DaysUntilAction is not { } due)
                        {
                            <span class="cell-sub">Covered until @InventoryFormat.ShortDate(plan.ProjectedStockout)</span>
                        }
                        else
                        {
                            var pill = InventoryFormat.ActionPill(due, Model.SoonDays);
                            <span class="@pill.CssClass">@pill.Text</span>
                            @if (plan.SendFromHome > 0)
                            {
                                <div>Send <strong>@plan.SendFromHome.ToString("N0", en)</strong> by @InventoryFormat.ShortDate(plan.SendBy)</div>
                            }
                            @if (plan.OrderFromSupplier > 0)
                            {
                                <div>Order <strong>@plan.OrderFromSupplier.ToString("N0", en)</strong> by @InventoryFormat.ShortDate(plan.OrderBy)</div>
                            }
                        }
                        @if (!item.LeadTimes.IsCustom)
                        {
                            <div class="cell-sub">default lead times</div>
                        }
                    </td>
                    @if (Model.CanEdit)
                    {
                        <td class="text-end"><a asp-page="Edit" asp-route-sku="@p.Sku" class="btn btn-sm btn-soft">Edit</a></td>
                    }
                </tr>
            }
            @if (Model.Overview.Items.Items.Count == 0)
            {
                <tr><td colspan="18" class="text-body-secondary p-3">@(string.IsNullOrWhiteSpace(Model.Search) && Model.FamilyId is null ? "No inventory yet. Turn on the FBA inventory sync in Tools → Amazon sync, or import an inventory file." : "No SKUs match your filter.")</td></tr>
            }
            </tbody>
        </table>
        </div>
    </div>
</div>
<partial name="_Pager" model="Model.Overview.Items.ToPager(Model.Search, Model.PagerFilters)" />
<p class="page-footnote">Sorted by the soonest restock action. Search matches SKU, ASIN, product name, or family. Totals cover every SKU that matches, not just this page. Days are @Model.Marketplace.Name local days.</p>
