@page
@using System.Globalization
@using AERai.Web.Application.Inventory
@model AERai.Web.UI.Pages.Inventory.IndexModel
@{
    ViewData["Title"] = "Inventory";
    var en = CultureInfo.GetCultureInfo("en-US");
    var t = Model.Overview.Totals;
    var rows = Model.Overview.Items.Items;
    var noInventory = t.SkuCount == 0 && !Model.IsFiltered;
}

@* ---------- Summary tiles (counts ignore the status filter, so they stay put when one is clicked) ---------- *@
<div class="row g-3 mb-3">
    <div class="col-6 col-xl-3">
        <a class="card tile h-100 @(t.RestockOverdue > 0 ? "tile-bad" : "")" href="@Model.StatusLink(StockStatusFilter.NeedsAction)">
            <div class="kpi">
                <div class="kpi-label">Needs restock <partial name="_Tip" model='"SKUs whose send or order deadline has passed or is within a week, worked back from when stock runs out and each SKU’s lead times. Click to list them."' /></div>
                <div class="kpi-value">@t.NeedsAction <span class="kpi-of">of @t.SkuCount SKUs</span></div>
                <div class="kpi-foot">
                    @if (t.NeedsAction == 0)
                    {
                        <span>Nothing due this week</span>
                    }
                    else
                    {
                        <span class="@(t.RestockOverdue > 0 ? "pill pill-bad" : "pill pill-warn")">@t.RestockOverdue overdue</span>
                        <span>@t.RestockSoon due soon</span>
                    }
                </div>
            </div>
        </a>
    </div>
    <div class="col-6 col-xl-3">
        <a class="card tile h-100 @(t.OutOfStock > 0 ? "tile-bad" : "")" href="@Model.StatusLink(StockStatusFilter.OutOfStock)">
            <div class="kpi">
                <div class="kpi-label">Out of stock <partial name="_Tip" model='"SKUs with nothing available at Amazon that sold in the last 30 days. Click to list them."' /></div>
                <div class="kpi-value">@t.OutOfStock</div>
                <div class="kpi-foot">@(t.OutOfStock == 0 ? "Every selling SKU is in stock" : "Losing sales now")</div>
            </div>
        </a>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card tile h-100">
            <div class="kpi">
                <div class="kpi-label">Sellable units <partial name="_Tip" model='"Units customers can buy right now. Total at Amazon also counts inbound, reserved, and unfulfillable units."' /></div>
                <div class="kpi-value">@t.Available.ToString("N0", en)</div>
                <div class="kpi-foot">@t.AmazonTotal.ToString("N0", en) at Amazon · @t.Inbound.ToString("N0", en) inbound</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        @if (Model.CanEdit)
        {
            <a class="card tile h-100" asp-page="HomeStock/Index">
                <div class="kpi">
                    <div class="kpi-label">Home stock <partial name="_Tip" model='"Units you hold outside Amazon for this marketplace. Click to update the counts."' /></div>
                    <div class="kpi-value">@t.HomeStock.ToString("N0", en)</div>
                    <div class="kpi-foot">@t.OverallTotal.ToString("N0", en) units overall</div>
                </div>
            </a>
        }
        else
        {
            <div class="card tile h-100">
                <div class="kpi">
                    <div class="kpi-label">Home stock <partial name="_Tip" model='"Units held outside Amazon for this marketplace."' /></div>
                    <div class="kpi-value">@t.HomeStock.ToString("N0", en)</div>
                    <div class="kpi-foot">@t.OverallTotal.ToString("N0", en) units overall</div>
                </div>
            </div>
        }
    </div>
</div>

@* ---------- Search + filters, Overview / Breakdown ---------- *@
<div class="list-toolbar mb-3">
    <form method="get" class="filters" data-autosubmit-form role="search">
        @if (Model.IsBreakdown)
        {
            <input type="hidden" name="view" value="breakdown" />
        }
        @if (Model.Descending)
        {
            <input type="hidden" name="desc" value="true" />
        }
        <div class="search-box">
            <partial name="_Icon" model='"search"' />
            <input type="search" name="q" value="@Model.Search" class="form-control form-control-sm" placeholder="Search SKU, ASIN, name, family…" aria-label="Search inventory" />
        </div>
        <select name="family" class="form-select form-select-sm" aria-label="Family">
            <option value="">All families</option>
            @foreach (var f in Model.Families)
            {
                <option value="@f.Id" selected="@(Model.FamilyId == f.Id)">@f.Name</option>
            }
        </select>
        <select name="status" class="form-select form-select-sm" aria-label="Status">
            @foreach (var (filter, label) in InventoryFormat.StatusFilters)
            {
                <option value="@(filter == StockStatusFilter.All ? "" : filter.ToString())" selected="@(Model.Status == filter)">@label</option>
            }
        </select>
        <select name="sort" class="form-select form-select-sm" aria-label="Sort by">
            @foreach (var (sort, label) in InventoryFormat.Sorts)
            {
                <option value="@(sort == InventorySort.Urgency ? "" : sort.ToString())" selected="@(Model.Sort == sort)">@label</option>
            }
        </select>
        <button type="submit" class="btn btn-sm btn-soft js-hide">Apply</button>
        @if (Model.IsFiltered)
        {
            <a href="@Url.Page("Index", new { view = Model.IsBreakdown ? "breakdown" : null })" class="btn btn-sm btn-link">Clear filters</a>
        }
    </form>
    <nav class="segmented" aria-label="Columns">
        <a href="@Model.Link(("view", null))" class="@(!Model.IsBreakdown ? "active" : "")"
           data-bs-toggle="tooltip" data-bs-title="Status, stock, cover, sales, and the next restock step.">Overview</a>
        <a href="@Model.Link(("view", "breakdown"))" class="@(Model.IsBreakdown ? "active" : "")"
           data-bs-toggle="tooltip" data-bs-title="Every Amazon stock state (inbound stages, reserved reasons) plus home stock.">Stock breakdown</a>
    </nav>
</div>

@* ---------- SKU list ---------- *@
<div class="card">
    <div class="card-toolbar">
        <span class="card-toolbar-title list-count">
            <span class="text-nowrap">@Model.Overview.Items.TotalCount.ToString("N0", en) SKU@(Model.Overview.Items.TotalCount == 1 ? "" : "s")</span>
            <span class="text-muted-token fw-normal">in @Model.Marketplace.Name@(t.SnapshotDate is { } d ? $" · Amazon snapshot {InventoryFormat.ShortDate(d)}" : "")</span>
        </span>
        @if (Model.CanEdit)
        {
            <div class="card-toolbar-group">
                <a asp-page="Families" asp-route-back="@Model.Back" class="btn btn-sm btn-soft" data-bs-toggle="modal" data-bs-target="#families-dialog"
                   title="Create, rename, or delete families"><partial name="_Icon" model='"tag"' /> Families</a>
                <a asp-page="Worksheet" class="btn btn-sm btn-soft"><partial name="_Icon" model='"grid"' /> Worksheet</a>
                <a asp-page="HomeStock/Ledger" class="btn btn-sm btn-soft"><partial name="_Icon" model='"list"' /> Ledger</a>
                <a asp-page="HomeStock/Index" class="btn btn-sm btn-soft"><partial name="_Icon" model='"edit"' /> Edit home stock</a>
                <a asp-page="HomeStock/Upload" class="btn btn-sm btn-soft btn-icon" aria-label="Upload home stock"
                   data-bs-toggle="tooltip" data-bs-title="Upload home stock from a spreadsheet (.xlsx or .csv)."><partial name="_Icon" model='"upload"' /></a>
            </div>
        }
    </div>
    @if (Model.CanEdit && rows.Count > 0 && !Model.IsBreakdown)
    {
        @* Bulk family assignment: tick rows (they belong to this form through form="family-bulk-form"),
           then type or pick a family. A new name creates the family. *@
        <form method="post" asp-page="Families" asp-page-handler="Assign" asp-route-back="@Model.Back" id="family-bulk-form"
              class="bulk-bar bulk-bar-row" data-bulk-bar data-bulk-noun="SKU">
            <span class="bulk-count" data-bulk-count>Tick SKUs to set their family or color.</span>
            <input type="text" name="family" list="family-names" class="form-control form-control-sm bulk-input" placeholder="Family name…"
                   maxlength="@FamilyNames.MaxLength" autocomplete="off" aria-label="Family for the selected SKUs" data-bulk-button />
            <datalist id="family-names">
                @foreach (var f in Model.Families)
                {
                    <option value="@f.Name"></option>
                }
            </datalist>
            <button type="submit" class="btn btn-sm btn-soft" data-bulk-button
                    data-bs-toggle="tooltip" data-bs-title="Put the ticked SKUs in this family. A new name creates it."><partial name="_Icon" model='"tag"' /> Set family</button>
            <button type="submit" name="clear" value="true" class="btn btn-sm btn-soft btn-icon" data-bulk-button aria-label="Remove the ticked SKUs from their family"
                    data-bs-toggle="tooltip" data-bs-title="Take the ticked SKUs out of their family."><partial name="_Icon" model='"x"' /></button>
            <span class="bulk-divider" aria-hidden="true"></span>
            <select name="color" class="form-select form-select-sm bulk-input" aria-label="Color for the selected SKUs" data-bulk-button>
                <option value="">No color</option>
                @foreach (var c in ColorFormat.All)
                {
                    <option value="@c">@ColorFormat.Label(c)</option>
                }
            </select>
            <button type="submit" asp-page="Colors" asp-page-handler="Assign" asp-route-back="@Model.Back" class="btn btn-sm btn-soft" data-bulk-button
                    data-bs-toggle="tooltip" data-bs-title="Give the ticked SKUs this color (groups them on the Worksheet). No color clears it.">Set color</button>
        </form>
    }

    @if (noInventory)
    {
        <div class="empty-state">
            <div class="empty-title">No inventory yet</div>
            <div class="empty-detail">Stock appears once the FBA inventory sync runs for @Model.Marketplace.Name, or after you import an inventory file.</div>
            <a asp-page="/Tools/Schedules/Index" class="btn btn-sm btn-soft"><partial name="_Icon" model='"plug"' /> Amazon sync</a>
        </div>
    }
    else if (rows.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-title">No SKUs match</div>
            <div class="empty-detail">Try a different search, family, or status.</div>
            <a href="@Url.Page("Index", new { view = Model.IsBreakdown ? "breakdown" : null })" class="btn btn-sm btn-soft">Clear filters</a>
        </div>
    }
    else if (!Model.IsBreakdown)
    {
        <div class="table-responsive">
            <table class="table data-table inventory-table align-middle mb-0 @(Model.CanEdit ? "has-select" : "")">
                <thead>
                    <tr>
                        @if (Model.CanEdit)
                        {
                            <th class="select-col"><input type="checkbox" class="form-check-input" data-select-all aria-label="Select all SKUs shown" /></th>
                        }
                        <th class="product-col"><a href="@Model.SortLink(InventorySort.Sku)" class="sort-link">Product @Model.SortArrow(InventorySort.Sku)</a></th>
                        <th><a href="@Model.SortLink(InventorySort.Urgency)" class="sort-link">Status @Model.SortArrow(InventorySort.Urgency)</a></th>
                        <th class="text-end"><a href="@Model.SortLink(InventorySort.Available)" class="sort-link">Available @Model.SortArrow(InventorySort.Available)</a></th>
                        <th><a href="@Model.SortLink(InventorySort.DaysOfInventory)" class="sort-link">Cover @Model.SortArrow(InventorySort.DaysOfInventory)</a>
                            <partial name="_Tip" model='"Days of inventory: how long sellable, inbound, and FC-transfer stock lasts at the current sales rate (home stock not counted). The bar compares it with the restock target."' /></th>
                        <th class="text-end col-sold"><a href="@Model.SortLink(InventorySort.Sold30d)" class="sort-link">Sold 30d @Model.SortArrow(InventorySort.Sold30d)</a></th>
                        <th class="text-end col-sold"><a href="@Model.SortLink(InventorySort.Sold90d)" class="sort-link">Sold 90d @Model.SortArrow(InventorySort.Sold90d)</a>
                            <partial name="_Tip" model='"Units sold in the window. Per day averages over the days since the first sale in that window, so a SKU (or sales history) newer than the window isn’t understated."' /></th>
                        <th>Next step <partial name="_Tip" model='"How many home-stock units to send into Amazon, and the last day to ship them: enough to cover the target days of sales, or Amazon’s own recommendation if it asks for more or sooner. Hover a row for the stockout date, reorder date, and lead times. Supplier reorders are on the Worksheet."' /></th>
                        @if (Model.CanEdit)
                        {
                            <th class="text-end"><span class="visually-hidden">Actions</span></th>
                        }
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in rows)
                {
                    var p = item.Position;
                    var status = InventoryFormat.Status(item);
                    <tr>
                        @if (Model.CanEdit)
                        {
                            <td class="select-col"><input type="checkbox" class="form-check-input" name="skus" value="@p.Sku" form="family-bulk-form" data-select-row aria-label="Select @p.Sku" /></td>
                        }
                        <td class="product-col"><partial name="_InventoryProduct" model="item" /></td>
                        <td><span class="@status.CssClass" title="@status.Tip">@status.Label</span></td>
                        <td class="text-end">
                            @if (p.SnapshotDate is null)
                            {
                                <span class="cell-sub">—</span>
                            }
                            else
                            {
                                <div class="fw-semibold">@p.Available.ToString("N0", en)</div>
                                @if (p.Inbound > 0)
                                {
                                    <div class="cell-sub">+@p.Inbound.ToString("N0", en) inbound</div>
                                }
                            }
                        </td>
                        <td>
                            @if (item.DaysOfInventory is { } days)
                            {
                                <div class="cover">
                                    <span class="cover-days">@days.ToString("N0", en) d</span>
                                    <svg class="cover-bar" width="@InventoryFormat.CoverBarWidth" height="6" viewBox="0 0 @InventoryFormat.CoverBarWidth 6" aria-hidden="true">
                                        <rect class="cover-track" x="0" y="0" width="@InventoryFormat.CoverBarWidth" height="6" rx="3" />
                                        <rect class="@InventoryFormat.CoverClass(item.Status)" x="0" y="0" width="@InventoryFormat.CoverWidth(item)" height="6" rx="3" />
                                    </svg>
                                </div>
                            }
                            else
                            {
                                <span class="cell-sub">—</span>
                            }
                        </td>
                        <td class="text-end col-sold">
                            <div>@item.UnitsSold30d.ToString("N0", en)</div>
                            @if (item.AveragePerDay30d is { } perDay30)
                            {
                                <div class="cell-sub">@perDay30.ToString("0.0", en)/day</div>
                            }
                        </td>
                        <td class="text-end col-sold">
                            <div>@item.UnitsSold90d.ToString("N0", en)</div>
                            @if (item.AveragePerDay90d is { } perDay90)
                            {
                                <div class="cell-sub">@perDay90.ToString("0.0", en)/day</div>
                            }
                        </td>
                        <td>
                            @{
                                var amazon = InventoryFormat.AmazonAdvice(p.AmazonRecommendedQuantity, p.AmazonRecommendedShipDate);
                            }
                            @if (item.Restock is { } plan && InventoryFormat.Send(plan) is { } send)
                            {
                                <div class="next-step" title="@InventoryFormat.StepsTip(item)">
                                    <div><strong>@send.Action</strong> <span class="text-muted-token">@send.When</span></div>
                                    @if (amazon is not null)
                                    {
                                        <div class="cell-sub">@amazon</div>
                                    }
                                    @if (plan.ShortAtHome > 0)
                                    {
                                        <div class="cell-sub text-warn">@plan.ShortAtHome.ToString("N0", en) more needed than home stock holds</div>
                                    }
                                </div>
                            }
                            else if (item.Restock is { } covered)
                            {
                                <div title="@InventoryFormat.StepsTip(item)">
                                    @if (covered.ShortAtHome > 0)
                                    {
                                        <div class="text-warn">Nothing at home to send</div>
                                    }
                                    else
                                    {
                                        <span class="cell-sub">Covered until @InventoryFormat.ShortDate(covered.ProjectedStockout)</span>
                                    }
                                    @if (amazon is not null)
                                    {
                                        <div class="cell-sub">@amazon</div>
                                    }
                                </div>
                            }
                            else if (amazon is not null)
                            {
                                <span class="cell-sub">@amazon</span>
                            }
                            else
                            {
                                <span class="cell-sub">—</span>
                            }
                        </td>
                        @if (Model.CanEdit)
                        {
                            <td class="text-end">
                                <a asp-page="Edit" asp-route-sku="@p.Sku" class="btn btn-sm btn-soft btn-icon" aria-label="Edit @p.Sku"
                                   data-bs-toggle="tooltip" data-bs-title="Edit family, picture, home stock, and lead times"><partial name="_Icon" model='"edit"' /></a>
                            </td>
                        }
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table data-table inventory-table align-middle mb-0">
                <thead>
                    <tr>
                        <th class="product-col"><a href="@Model.SortLink(InventorySort.Sku)" class="sort-link">Product @Model.SortArrow(InventorySort.Sku)</a></th>
                        <th class="text-end"><a href="@Model.SortLink(InventorySort.Available)" class="sort-link">Available @Model.SortArrow(InventorySort.Available)</a></th>
                        <th class="text-end col-group" title="On a shipment plan, not shipped yet"><span class="th-group">Inbound</span>Working</th>
                        <th class="text-end" title="In transit to Amazon"><span class="th-group">Inbound</span>Shipped</th>
                        <th class="text-end" title="Arrived and being checked in"><span class="th-group">Inbound</span>Receiving</th>
                        <th class="text-end col-group" title="Sold, waiting to ship"><span class="th-group">Reserved</span>Orders</th>
                        <th class="text-end" title="Moving between fulfillment centers"><span class="th-group">Reserved</span>Transfer</th>
                        <th class="text-end" title="Held for measuring or investigation"><span class="th-group">Reserved</span>Processing</th>
                        <th class="text-end col-group">Unfulfillable</th>
                        <th class="text-end">Home</th>
                        <th class="text-end col-group">Total</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in rows)
                {
                    var p = item.Position;
                    <tr>
                        <td class="product-col"><partial name="_InventoryProduct" model="item" /></td>
                        <td class="text-end fw-semibold">@p.Available.ToString("N0", en)</td>
                        @if (p.HasInboundBreakdown)
                        {
                            <td class="text-end col-group">@Units(p.InboundWorking)</td>
                            <td class="text-end">@Units(p.InboundShipped)</td>
                            <td class="text-end">@Units(p.InboundReceiving)</td>
                        }
                        else
                        {
                            <td colspan="3" class="text-end col-group" title="This source gives inbound as one total">@p.Inbound.ToString("N0", en) <span class="cell-sub">total</span></td>
                        }
                        @if (p.HasReservedBreakdown)
                        {
                            <td class="text-end col-group">@Units(p.ReservedCustomerOrder)</td>
                            <td class="text-end">@Units(p.ReservedFcTransfer)</td>
                            <td class="text-end">@Units(p.ReservedFcProcessing)</td>
                        }
                        else
                        {
                            <td colspan="3" class="text-end col-group" title="No reserved-inventory report for this date, so only the total is known">@p.Reserved.ToString("N0", en) <span class="cell-sub">total</span></td>
                        }
                        <td class="text-end col-group">@Units(p.Unfulfillable)</td>
                        <td class="text-end">@Units(p.HomeStock)</td>
                        <td class="text-end col-group fw-semibold">@p.OverallTotal.ToString("N0", en)</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
<partial name="_Pager" model="Model.Overview.Items.ToPager(Model.Search, Model.PagerFilters)" />

@functions {
    // Zero is shown as a muted dash so the numbers that matter stand out.
    private static Microsoft.AspNetCore.Html.IHtmlContent Units(int value) =>
        value == 0
            ? new Microsoft.AspNetCore.Html.HtmlString("<span class=\"zero\">–</span>")
            : new Microsoft.AspNetCore.Html.HtmlString(value.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("en-US")));
}

@if (Model.CanEdit)
{
    <div class="modal fade" id="families-dialog" tabindex="-1" aria-labelledby="families-title" aria-hidden="true" data-open-on-load="@(Model.OpenFamilies ? "true" : null)" data-open-param="families">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title h6" id="families-title">Families</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <partial name="_FamilyManager" model="new FamilyManagerModel(Model.Families, Model.Back)" />
                </div>
            </div>
        </div>
    </div>
}
