{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "docker: start SQL Server + Azurite",
      "type": "shell",
      "command": "docker compose up -d sql2025 azurite",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "build",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/src/AERai.Web.UI/AERai.Web.UI.csproj", "/property:GenerateFullPaths=true", "/consoleloggerparameters:NoSummary"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "test",
      "type": "process",
      "command": "dotnet",
      "args": ["test", "${workspaceFolder}/AERai.Web.slnx"],
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "watch (hot reload)",
      "type": "process",
      "command": "dotnet",
      "args": ["watch", "run", "--project", "${workspaceFolder}/src/AERai.Web.UI", "--launch-profile", "http"],
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
