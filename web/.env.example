# Copy to .env (gitignored) and fill in. Never commit real values.

# SA password for the local SQL Server container. Must meet SQL Server complexity rules
# (8+ chars, 3 of: upper, lower, digit, symbol).
MSSQL_SA_PASSWORD=ChangeMe-Local-Only-1

# Optional: first administrator for the containerized app (docker compose --profile app).
SEED_ADMIN_EMAIL=admin@aeraigroup.com
SEED_ADMIN_PASSWORD=ChangeMe-Admin-Pw-1
