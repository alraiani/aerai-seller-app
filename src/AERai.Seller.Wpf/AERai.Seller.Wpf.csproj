<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\AERai.Seller.Presentation\AERai.Seller.Presentation.csproj" />
    <ProjectReference Include="..\AERai.Seller.Infrastructure\AERai.Seller.Infrastructure.csproj" />
    <ProjectReference Include="..\AERai.Seller.SpApiClient\AERai.Seller.SpApiClient.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" Version="2.0.5" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Not "AERai.Seller.Wpf": that C# namespace, ending in "Wpf", collides with the
         referenced third-party "Wpf.Ui" namespace for any unqualified reference inside
         this project. See CLAUDE.md's namespace-collision note. -->
    <RootNamespace>AERai.Seller.Desktop</RootNamespace>
  </PropertyGroup>

</Project>
