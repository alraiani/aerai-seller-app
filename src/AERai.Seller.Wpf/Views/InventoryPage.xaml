<Page x:Class="AERai.Seller.Desktop.Views.InventoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:viewModels="clr-namespace:AERai.Seller.Presentation.ViewModels;assembly=AERai.Seller.Presentation"
      d:DataContext="{d:DesignInstance Type=viewModels:InventoryViewModel}"
      mc:Ignorable="d"
      Title="Inventory">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="Inventory" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <ui:ProgressRing IsIndeterminate="True"
                             Width="18" Height="18"
                             Margin="12,0,0,0"
                             VerticalAlignment="Center"
                             Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </StackPanel>

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Rows}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  GridLinesVisibility="None">
            <DataGrid.Columns>
                <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="*"/>
                <DataGridTextColumn Header="Available" Binding="{Binding Available}" Width="110"/>
                <DataGridTextColumn Header="Inbound" Binding="{Binding Inbound}" Width="110"/>
                <DataGridTextColumn Header="Reserved" Binding="{Binding Reserved}" Width="110"/>
                <DataGridTextColumn Header="Unfulfillable" Binding="{Binding Unfulfillable}" Width="120"/>
                <DataGridCheckBoxColumn Header="Low Stock" Binding="{Binding LowStock}" Width="90"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
