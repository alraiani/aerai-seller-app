<Page x:Class="AERai.Seller.Desktop.Views.BookkeepingAccountMappingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:viewModels="clr-namespace:AERai.Seller.Presentation.ViewModels;assembly=AERai.Seller.Presentation"
      xmlns:behaviors="clr-namespace:AERai.Seller.Desktop.Behaviors"
      d:DataContext="{d:DesignInstance Type=viewModels:BookkeepingAccountMappingViewModel}"
      mc:Ignorable="d"
      Title="Account Mapping">
    <!-- No page-level ScrollViewer here: NavigationView's content host already wraps every
         navigated page in its own DynamicScrollViewer — see CLAUDE.md gotcha. -->
    <StackPanel MaxWidth="900" HorizontalAlignment="Stretch" Margin="24">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="Account Mapping" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <ui:ProgressRing IsIndeterminate="True"
                             Width="18" Height="18"
                             Margin="12,0,0,0"
                             VerticalAlignment="Center"
                             Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </StackPanel>

        <TextBlock Text="Bookkeeping Settings" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBlock Text="Deposit Account (QuickBooks account the Amazon payout lands in)" Margin="0,0,0,4"/>
        <ui:TextBox Text="{Binding DepositAccountName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

        <TextBlock Text="Export Folder Override (optional — defaults to %AppData%\AERaiSellerApp\BookkeepingExports)" Margin="0,0,0,4"/>
        <ui:TextBox Text="{Binding ExportFolderPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,20"/>

        <TextBlock Text="Amazon Category → QuickBooks Account" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBlock Text="Every raw Amazon settlement category seen so far. Multiple categories can share the same QuickBooks account name — leave blank to leave a category unmapped, which blocks exporting any settlement that contains it."
                   Opacity="0.7" Margin="0,0,0,12" TextWrapping="Wrap"/>

        <ui:Card Margin="0,0,0,16">
            <DataGrid ItemsSource="{Binding Rows}"
                      AutoGenerateColumns="False"
                      IsReadOnly="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="None"
                      MaxHeight="480"
                      behaviors:ScrollBehavior.BubbleScroll="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Amount Type" Binding="{Binding AmountType}" Width="160" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Amount Description" Binding="{Binding AmountDescription}" Width="180" IsReadOnly="True"/>
                    <DataGridTextColumn Header="QuickBooks Account" Binding="{Binding QuickBooksAccountName, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                    <DataGridCheckBoxColumn Header="Unmapped" Binding="{Binding IsUnmapped}" Width="80" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>
        </ui:Card>

        <ui:Button Content="Save" Appearance="Primary" Command="{Binding SaveCommand}" Margin="0,0,0,8"/>
        <TextBlock Text="{Binding SaveStatusMessage}" Opacity="0.8"/>
    </StackPanel>
</Page>
