<Page x:Class="AERai.Seller.Desktop.Views.CatalogItemSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:viewModels="clr-namespace:AERai.Seller.Presentation.ViewModels;assembly=AERai.Seller.Presentation"
      xmlns:behaviors="clr-namespace:AERai.Seller.Desktop.Behaviors"
      d:DataContext="{d:DesignInstance Type=viewModels:CatalogItemSettingsViewModel}"
      mc:Ignorable="d"
      Title="Catalog Item Settings">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="Catalog Item Settings" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <ui:ProgressRing IsIndeterminate="True"
                             Width="18" Height="18"
                             Margin="12,0,0,0"
                             VerticalAlignment="Center"
                             Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </StackPanel>

        <ui:Card Grid.Row="1" Grid.Column="0">
            <DataGrid ItemsSource="{Binding Items}"
                      SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="None"
                      behaviors:ScrollBehavior.BubbleScroll="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="110"/>
                    <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </ui:Card>

        <StackPanel Grid.Row="1" Grid.Column="2" MaxWidth="500" HorizontalAlignment="Left">
            <TextBlock Text="{Binding SelectedItem.Title, TargetNullValue='Select an item on the left'}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBlock Text="{Binding SelectedItem.Sku}" Opacity="0.7" Margin="0,0,0,16"/>

            <TextBlock Text="Cost of Goods" Margin="0,0,0,4"/>
            <ui:TextBox Text="{Binding CostOfGoods, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

            <TextBlock Text="Supplier Lead Time (days)" Margin="0,0,0,4"/>
            <ui:NumberBox Value="{Binding SupplierLeadTimeDays, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

            <TextBlock Text="Prep Time (days)" Margin="0,0,0,4"/>
            <ui:NumberBox Value="{Binding PrepTimeDays, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

            <TextBlock Text="FBA Transit Time (days)" Margin="0,0,0,4"/>
            <ui:NumberBox Value="{Binding FbaTransitDays, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

            <TextBlock Text="Safety Stock (days)" Margin="0,0,0,4"/>
            <ui:NumberBox Value="{Binding SafetyStockDays, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

            <CheckBox Content="Override target stock days for this SKU"
                      IsChecked="{Binding OverrideTargetStockDays}"
                      Margin="0,0,0,8"/>
            <TextBlock Text="Target Stock Days" Margin="0,0,0,4"/>
            <ui:NumberBox Value="{Binding TargetStockDays, UpdateSourceTrigger=PropertyChanged}"
                          IsEnabled="{Binding OverrideTargetStockDays}"
                          Margin="0,0,0,4"/>
            <TextBlock Text="{Binding GlobalDefaultTargetStockDays, StringFormat='Global default: {0} days (set on Settings page)'}"
                       Opacity="0.6" FontSize="12" Margin="0,0,0,20"/>

            <ui:Button Content="Save" Appearance="Primary" Command="{Binding SaveCommand}" Margin="0,0,0,8"/>
            <TextBlock Text="{Binding SaveStatusMessage}" Opacity="0.8"/>
        </StackPanel>
    </Grid>
</Page>
