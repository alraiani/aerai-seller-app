@page
@model AERai.Web.UI.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot password";
}
<div class="login-wrapper">
    <div class="card shadow login-card">
        <div class="card-body p-4">
            <h1 class="h4 login-brand mb-1">Forgot your password?</h1>
            <p class="text-body-secondary mb-4">Enter your account email and we'll send you a link to choose a new one.</p>
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>
                <div class="mb-4">
                    <label asp-for="Input.Email" class="form-label">Email</label>
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" autofocus />
                    <span asp-validation-for="Input.Email" class="text-danger small"></span>
                </div>
                <button type="submit" class="btn btn-primary w-100">Email me a reset link</button>
            </form>
            <p class="small mt-4 mb-0"><a asp-page="/Account/Login">Back to sign in</a></p>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
