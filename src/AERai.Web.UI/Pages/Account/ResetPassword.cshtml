@page
@using AERai.Web.Application.Security
@model AERai.Web.UI.Pages.Account.ResetPasswordModel
@{
    ViewData["Title"] = "Choose a new password";
}
<div class="login-wrapper">
    <div class="card shadow login-card">
        <div class="card-body p-4">
            <h1 class="h4 login-brand mb-3">Choose a new password</h1>
            @if (Model.LinkIncomplete)
            {
                <p>@PasswordResetService.InvalidLinkMessage</p>
                <a asp-page="/Account/ForgotPassword" class="btn btn-primary w-100">Request a new link</a>
            }
            else
            {
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>
                    <input type="hidden" asp-for="UserId" />
                    <input type="hidden" asp-for="Token" />
                    <div class="mb-3">
                        <label asp-for="Input.NewPassword" class="form-label"></label>
                        <input asp-for="Input.NewPassword" class="form-control" autocomplete="new-password" autofocus />
                        <span asp-validation-for="Input.NewPassword" class="text-danger small"></span>
                        <div class="form-text">At least 12 characters, with upper-case, lower-case, and a number.</div>
                    </div>
                    <div class="mb-4">
                        <label asp-for="Input.ConfirmPassword" class="form-label"></label>
                        <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Set new password</button>
                </form>
                <p class="small mt-4 mb-0"><a asp-page="/Account/ForgotPassword">Request a new link</a></p>
            }
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
