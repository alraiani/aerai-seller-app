@page
@using AERai.Web.Application.Security
@model AERai.Web.UI.Pages.Account.ForgotPasswordConfirmationModel
@{
    ViewData["Title"] = "Check your email";
}
<div class="login-wrapper">
    <div class="card shadow login-card">
        <div class="card-body p-4">
            <h1 class="h4 login-brand mb-2">Check your email</h1>
            <p class="mb-3">If an account exists for that address, we've sent a link to reset its password.</p>
            <p class="text-body-secondary small mb-4">
                The link expires in @((int)PasswordResetService.LinkLifetime.TotalMinutes) minutes and works once.
                Nothing there? Check spam, or ask an administrator.
            </p>
            <a asp-page="/Account/Login" class="btn btn-outline-primary w-100">Back to sign in</a>
        </div>
    </div>
</div>
