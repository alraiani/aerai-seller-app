@page
@using System.Globalization
@using AERai.Web.Application.Settlements
@model AERai.Web.UI.Pages.Settlements.DeferredModel
@{
    ViewData["Title"] = "Deferred by Amazon";
    var rows = Model.Rows.Items;
    var released = Model.View == DeferredView.Released;
    var isFiltered = !string.IsNullOrWhiteSpace(Model.Search);
}

<nav class="crumbs" aria-label="Breadcrumb">
    <a asp-page="Index">Settlements</a>
    <span aria-hidden="true">/</span>
    <span>Deferred by Amazon</span>
</nav>

<partial name="_DeferredTile" model="(Model.Overview, Model.Zone)" />

@* ---------- Search, view ---------- *@
<div class="list-toolbar mb-3">
    <form method="get" class="filters" role="search">
        @foreach (var (key, value) in Model.CurrentFilters())
        {
            <input type="hidden" name="@key" value="@value" />
        }
        <div class="search-box">
            <partial name="_Icon" model='"search"' />
            <input type="search" name="q" value="@Model.Search" class="form-control form-control-sm" placeholder="Search order id…" aria-label="Search deferred payouts" />
        </div>
        <button type="submit" class="btn btn-sm btn-soft js-hide">Search</button>
        @if (isFiltered)
        {
            <a href="@Model.LinkWith(("q", null), ("p", null))" class="btn btn-sm btn-link">Clear search</a>
        }
    </form>
    <nav class="segmented" aria-label="View">
        <a href="@Model.ViewLink(DeferredView.Deferred)" class="@(released ? "" : "active")"
           data-bs-toggle="tooltip" data-bs-title="What Amazon still holds back.">Still held</a>
        <a href="@Model.ViewLink(DeferredView.Released)" class="@(released ? "active" : "")"
           data-bs-toggle="tooltip" data-bs-title="Released into a settlement in the last 30 days.">Released (30 days)</a>
    </nav>
</div>

<div class="card">
    <div class="card-toolbar">
        <span class="card-toolbar-title list-count">
            <span class="text-nowrap">@Model.Rows.TotalCount.ToString("N0", CultureInfo.InvariantCulture) transaction@(Model.Rows.TotalCount == 1 ? "" : "s")</span>
            <span class="text-muted-token fw-normal">in @Model.Marketplace.Name · @(released ? "released" : "still held")</span>
            <partial name="_Tip" model='"One row per Amazon transaction (usually one per shipped order). Amount is what Amazon will pay out for it, after its fees. DD7 = held until 7 days after delivery; B2B = held until an invoiced business order is paid."' />
        </span>
    </div>
    @if (rows.Count == 0)
    {
        <div class="empty-state">
            @if (isFiltered)
            {
                <div class="empty-title">No transactions match</div>
                <div class="empty-detail">Try a different order id.</div>
            }
            else if (!Model.Overview.IsSynced)
            {
                <div class="empty-title">Not synced yet</div>
                <div class="empty-detail">Turn on the Deferred payments schedule for @Model.Marketplace.Name, or run it now.</div>
                <a asp-page="/Tools/Schedules/Index" class="btn btn-sm btn-soft"><partial name="_Icon" model='"plug"' /> Amazon sync</a>
            }
            else
            {
                <div class="empty-title">@(released ? "Nothing released in the last 30 days" : "Amazon holds nothing back")</div>
                <div class="empty-detail">@(released ? "Deferred payouts show here once Amazon pays them into a settlement." : "Every sale so far has been paid out or is in an open settlement.")</div>
            }
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table data-table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Order</th>
                        <th>Reason</th>
                        <th><a href="@Model.SortLink(DeferredSort.Posted)" class="sort-link">Posted @Model.SortArrow(DeferredSort.Posted)</a></th>
                        <th><a href="@Model.SortLink(DeferredSort.Maturity)" class="sort-link">@(released ? "Released" : "Releases on") @Model.SortArrow(DeferredSort.Maturity)</a></th>
                        <th class="text-end"><a href="@Model.SortLink(DeferredSort.Amount)" class="sort-link">Amount @Model.SortArrow(DeferredSort.Amount)</a></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in rows)
                    {
                        <tr>
                            <td>
                                @if (r.AmazonOrderId is { } orderId)
                                {
                                    <a asp-page="/Orders/Index" asp-route-q="@orderId" class="fw-semibold text-nowrap">@orderId</a>
                                }
                                else
                                {
                                    <span class="fw-semibold">No order</span>
                                }
                                <div class="cell-sub">@r.Description</div>
                            </td>
                            <td><span class="pill pill-info" title="@SettlementFormat.DeferralReasonTitle(r.DeferralReason)">@(r.DeferralReason ?? "—")</span></td>
                            <td class="text-nowrap">@SettlementFormat.Day(r.PostedDate, Model.Zone)</td>
                            <td class="text-nowrap">
                                @SettlementFormat.Day(released ? r.ReleasedAt ?? r.MaturityDate : r.MaturityDate, Model.Zone)
                                @if (!released && Model.Overview.IsDue(r.MaturityDate))
                                {
                                    <span class="pill pill-ok ms-1" title="The release date has passed; Amazon pays it out with the next settlement.">Due</span>
                                }
                            </td>
                            <td class="text-end money fw-semibold @SettlementFormat.AmountClass(r.Amount)">@SettlementFormat.Money(r.Amount, r.Currency ?? Model.Marketplace.Currency)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<partial name="_Pager" model="Model.Rows.ToPager(Model.Search, Model.CurrentFilters())" />
