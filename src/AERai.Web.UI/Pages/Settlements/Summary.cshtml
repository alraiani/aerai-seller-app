@page "{id}"
@using System.Globalization
@model AERai.Web.UI.Pages.Settlements.SummaryModel
@{
    var s = Model.Settlement;
    ViewData["Title"] = $"Settlement {s.SettlementId}";
}
<div class="card-toolbar">
    <p class="text-body-secondary mb-0">
        Period @s.PeriodStart?.ToString("yyyy-MM-dd") – @s.PeriodEnd?.ToString("yyyy-MM-dd"). Net payout <strong>@s.Net.ToString("N2") @s.Currency</strong>.
        One row per SKU and price each, with the units sold at that price; select a row to see the lines behind it.
    </p>
    <a asp-page="Index" class="btn btn-outline-secondary btn-sm">All settlements</a>
</div>
<partial name="_SearchForm" model="Model.Search" />
<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
        <table class="table table-sm table-hover mb-0">
            <thead>
                <tr><th>SKU</th><th>ASIN</th><th class="text-end">Price each</th><th>Currency</th><th class="text-end">Units</th><th class="text-end">Orders</th><th class="text-end">Sales</th><th class="text-end">Fees</th><th class="text-end">Refunds</th><th class="text-end">Other</th><th class="text-end">Net</th></tr>
            </thead>
            <tbody>
            @foreach (var r in Model.Rows.Items)
            {
                <tr>
                    <td>
                        <a asp-page="Lines" asp-route-id="@r.SettlementId" asp-route-sku="@r.Sku" asp-route-price="@r.SalePrice?.ToString(CultureInfo.InvariantCulture)">@(r.Sku ?? "(no SKU)")</a>
                        @if (r.Title is not null)
                        {
                            <div class="small text-body-secondary cell-truncate" title="@r.Title">@r.Title</div>
                        }
                    </td>
                    <td>@r.Asin</td>
                    <td class="text-end">@r.SalePrice?.ToString("N2")</td>
                    <td>@r.Currency</td>
                    <td class="text-end">@r.Units.ToString("N0")</td>
                    <td class="text-end">@r.OrderCount</td>
                    <td class="text-end">@r.Sales.ToString("N2")</td>
                    <td class="text-end">@r.Fees.ToString("N2")</td>
                    <td class="text-end">@r.Refunds.ToString("N2")</td>
                    <td class="text-end">@r.Other.ToString("N2")</td>
                    <td class="text-end fw-semibold">@r.Net.ToString("N2")</td>
                </tr>
            }
            @if (Model.Rows.Items.Count == 0)
            {
                <tr><td colspan="11" class="text-body-secondary p-3">Nothing to show for this settlement.</td></tr>
            }
            </tbody>
            <tfoot>
                <tr class="fw-semibold">
                    <td colspan="4">Settlement total</td>
                    <td class="text-end">@s.Units.ToString("N0")</td>
                    <td></td>
                    <td class="text-end">@s.Sales.ToString("N2")</td>
                    <td class="text-end">@s.Fees.ToString("N2")</td>
                    <td class="text-end">@s.Refunds.ToString("N2")</td>
                    <td class="text-end">@s.Other.ToString("N2")</td>
                    <td class="text-end">@s.Net.ToString("N2")</td>
                </tr>
            </tfoot>
        </table>
        </div>
    </div>
</div>
<partial name="_Pager" model="Model.Rows.ToPager(Model.Search)" />
