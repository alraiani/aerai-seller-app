@page "{id}"
@model AERai.Web.UI.Pages.Settlements.SummaryModel
@{
    var s = Model.Settlement;
    ViewData["Title"] = $"Settlement {s.SettlementId}";
}

<nav class="crumbs" aria-label="Breadcrumb">
    <a asp-page="Index">Settlements</a>
    <span aria-hidden="true">/</span>
    <span>@s.SettlementId</span>
</nav>

@* The amounts switch, row filter, search, sorts, and pager reload only this section (site.js partial reloads). *@
<div data-fragment="settlement-summary">
    <partial name="_SummaryBody" />
</div>
