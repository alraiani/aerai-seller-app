@page "{id}"
@using System.Globalization
@using AERai.Web.Application.Settlements
@model AERai.Web.UI.Pages.Settlements.SummaryModel
@{
    var s = Model.Settlement;
    var total = SettlementMoney.Of(s, Model.Amounts);
    var rows = Model.Rows.Items;
    var anyReserve = s.Reserve != 0;
    var anyDeferred = Model.SkuDeferrals.Count > 0;
    var amountsRoute = Model.Amounts == SettlementAmounts.Home ? null : Model.Amounts.ToString();
    ViewData["Title"] = $"Settlement {s.SettlementId}";
}

<nav class="crumbs" aria-label="Breadcrumb">
    <a asp-page="Index">Settlements</a>
    <span aria-hidden="true">/</span>
    <span>@s.SettlementId</span>
</nav>

@* ---------- The payout at a glance ---------- *@
<div class="card mb-3">
    <div class="settlement-head">
        <div>
            <div class="kpi-label">Net payout · @SettlementFormat.Period(s.PeriodStart, s.PeriodEnd, Model.Zone)</div>
            <div class="kpi-value @SettlementFormat.AmountClass(total.Net)">@SettlementFormat.Money(total.Net, total.Currency)</div>
            <div class="kpi-foot">@s.Units.ToString("N0", CultureInfo.InvariantCulture) unit@(s.Units == 1 ? "" : "s") sold@(SettlementFormat.Day(s.DepositDate, Model.Zone) is { } deposit ? " · paid out " + deposit : "")</div>
            @if (Model.DeferredOut is { } held)
            {
                @* Sales made in this period that Amazon held back: they are paid in a later settlement, so they are not in this Net. *@
                <a class="deferred-out mt-2" asp-page="Deferred" asp-route-settlement="@s.SettlementId" asp-route-view="All" title="@SettlementFormat.DeferredTitle(held, Model.Zone)">
                    <partial name="_Icon" model='"clock"' />
                    <span><strong>@SettlementFormat.Money(held.Amount, held.Currency)</strong> deferred out of this payout</span>
                    <span class="text-muted-token">
                        · @held.Count.ToString("N0", CultureInfo.InvariantCulture) sale@(held.Count == 1 ? "" : "s")
                        · @(held.IsAllReleased ? "all paid out since" : $"{SettlementFormat.Money(held.HeldAmount, held.Currency)} still held")
                    </span>
                </a>
            }
        </div>
        <partial name="_SettlementBreakdown" model="(total.Sales, total.Refunds, total.Expenses, total.Reserve, total.Net, total.Currency)" />
    </div>
</div>

<partial name="_SettlementRate" model="Model.RatePanel" />

@if (Model.Deferrals.Orders > 0)
{
    @* Deferred sales arrive in a later settlement than the one they were sold in, which is why a payout can be larger than that period's sales suggest. *@
    <div class="page-footnote mt-n2 mb-3">
        <partial name="_Icon" model='"clock"' />
        Includes @Model.Deferrals.Orders.ToString("N0", CultureInfo.InvariantCulture) order@(Model.Deferrals.Orders == 1 ? "" : "s") Amazon deferred earlier
        (@string.Join(" + ", Model.Deferrals.Amounts.Select(a => SettlementFormat.Money(a.Amount, a.Currency))) released into this payout).
        Their lines are marked on each row's orders.
        <a asp-page="Deferred">What Amazon still holds</a>
    </div>
}

@* ---------- Search, row filter ---------- *@
<div class="list-toolbar mb-3">
    <form method="get" class="filters" role="search">
        @foreach (var (key, value) in Model.CurrentFilters())
        {
            <input type="hidden" name="@key" value="@value" />
        }
        <div class="search-box">
            <partial name="_Icon" model='"search"' />
            <input type="search" name="q" value="@Model.Search" class="form-control form-control-sm" placeholder="Search SKU, ASIN, title…" aria-label="Search this settlement" />
        </div>
        <button type="submit" class="btn btn-sm btn-soft js-hide">Search</button>
        @if (Model.IsFiltered)
        {
            <a asp-page="Summary" asp-route-id="@s.SettlementId" class="btn btn-sm btn-link">Clear filters</a>
        }
    </form>
    <nav class="segmented" aria-label="Rows">
        <a href="@Model.KindLink(SettlementRowKind.All)" class="@(Model.Kind == SettlementRowKind.All ? "active" : "")">All rows</a>
        <a href="@Model.KindLink(SettlementRowKind.WithRefunds)" class="@(Model.Kind == SettlementRowKind.WithRefunds ? "active" : "")"
           data-bs-toggle="tooltip" data-bs-title="SKUs and prices with any refund in this settlement.">With refunds</a>
        <a href="@Model.KindLink(SettlementRowKind.NoSku)" class="@(Model.Kind == SettlementRowKind.NoSku ? "active" : "")"
           data-bs-toggle="tooltip" data-bs-title="Amounts that belong to no product: subscription, storage, and other service fees.">No SKU</a>
    </nav>
</div>

<div class="card">
    <div class="card-toolbar">
        <span class="card-toolbar-title list-count">
            <span class="text-nowrap">@Model.Rows.TotalCount.ToString("N0", CultureInfo.InvariantCulture) row@(Model.Rows.TotalCount == 1 ? "" : "s")</span>
            <span class="text-muted-token fw-normal">by SKU and price each</span>
            <partial name="_Tip" model='"One row per SKU and price each, with the units sold at that price. Open a row to see the orders behind it."' />
        </span>
    </div>
    @if (rows.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-title">@(Model.IsFiltered ? "No rows match" : "Nothing to show for this settlement")</div>
            @if (Model.IsFiltered)
            {
                <div class="empty-detail">Try a different search or show all rows.</div>
                <a asp-page="Summary" asp-route-id="@s.SettlementId" class="btn btn-sm btn-soft">Clear filters</a>
            }
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table data-table settlement-table align-middle mb-0">
                <thead>
                    <tr>
                        <th><a href="@Model.SortLink(SettlementSkuSort.Sku)" class="sort-link">Product @Model.SortArrow(SettlementSkuSort.Sku)</a></th>
                        <th class="text-end">Price each</th>
                        <th class="text-end"><a href="@Model.SortLink(SettlementSkuSort.Units)" class="sort-link">Units @Model.SortArrow(SettlementSkuSort.Units)</a></th>
                        <th class="text-end"><a href="@Model.SortLink(SettlementSkuSort.Orders)" class="sort-link">Orders @Model.SortArrow(SettlementSkuSort.Orders)</a></th>
                        <th class="text-end"><a href="@Model.SortLink(SettlementSkuSort.Sales)" class="sort-link">Sales @Model.SortArrow(SettlementSkuSort.Sales)</a></th>
                        <th class="text-end"><a href="@Model.SortLink(SettlementSkuSort.Refunds)" class="sort-link">Refunds @Model.SortArrow(SettlementSkuSort.Refunds)</a></th>
                        <th class="text-end"><a href="@Model.SortLink(SettlementSkuSort.Expenses)" class="sort-link">Expenses @Model.SortArrow(SettlementSkuSort.Expenses)</a></th>
                        @if (anyReserve)
                        {
                            <th class="text-end">Reserve</th>
                        }
                        <th class="text-end"><a href="@Model.SortLink(SettlementSkuSort.Net)" class="sort-link">Net @Model.SortArrow(SettlementSkuSort.Net)</a></th>
                        @if (anyDeferred)
                        {
                            <th class="text-end">Deferred <partial name="_Tip" model='"Units of this SKU and price sold in this period that Amazon held back, and what it pays out for them in a later settlement. Not in Net."' /></th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in rows)
                    {
                        var m = SettlementMoney.Of(r, Model.Amounts);
                        <tr>
                            <td>
                                <a asp-page="Lines" asp-route-id="@r.SettlementId" asp-route-sku="@r.Sku" asp-route-price="@r.SalePrice?.ToString(CultureInfo.InvariantCulture)" asp-route-amounts="@amountsRoute" class="fw-semibold">@(r.Sku ?? "No SKU (service fees)")</a>
                                @if (r.Title is not null || r.Asin is not null)
                                {
                                    <div class="cell-sub cell-truncate" title="@r.Title">@(r.Asin is null ? "" : r.Asin + " · ")@r.Title</div>
                                }
                            </td>
                            <td class="text-end money">@(SettlementMoney.SalePriceOf(r, Model.Amounts) is { } price ? SettlementFormat.Money(price, m.Currency) : "")</td>
                            <td class="text-end money">@r.Units.ToString("N0", CultureInfo.InvariantCulture)</td>
                            <td class="text-end money">@r.OrderCount.ToString("N0", CultureInfo.InvariantCulture)</td>
                            <td class="text-end money">@SettlementFormat.Money(m.Sales, m.Currency)</td>
                            <td class="text-end money @SettlementFormat.AmountClass(m.Refunds)">@SettlementFormat.Money(m.Refunds, m.Currency)</td>
                            <td class="text-end money @SettlementFormat.AmountClass(m.Expenses)">@SettlementFormat.Money(m.Expenses, m.Currency)</td>
                            @if (anyReserve)
                            {
                                <td class="text-end money @SettlementFormat.AmountClass(m.Reserve)">@SettlementFormat.Money(m.Reserve, m.Currency)</td>
                            }
                            <td class="text-end money fw-semibold @SettlementFormat.AmountClass(m.Net)">@SettlementFormat.Money(m.Net, m.Currency)</td>
                            @if (anyDeferred)
                            {
                                <td class="text-end money text-nowrap">
                                    @if (Model.DeferredFor(r) is { } skuHeld)
                                    {
                                        <span class="deferred-amount" title="@skuHeld.Quantity.ToString("N0", CultureInfo.InvariantCulture) unit@(skuHeld.Quantity == 1 ? "" : "s") in @skuHeld.Orders.ToString("N0", CultureInfo.InvariantCulture) order@(skuHeld.Orders == 1 ? "" : "s") held back">
                                            <partial name="_Icon" model='"clock"' />@SettlementFormat.Money(skuHeld.Amount, skuHeld.Currency)
                                        </span>
                                    }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
                @if (!Model.IsFiltered)
                {
                    @* Converted rows are each rounded, so in the marketplace's currency they can differ from the settlement total by a cent or two. *@
                    <tfoot>
                        <tr>
                            <td colspan="2">Settlement total</td>
                            <td class="text-end money">@s.Units.ToString("N0", CultureInfo.InvariantCulture)</td>
                            <td></td>
                            <td class="text-end money">@SettlementFormat.Money(total.Sales, total.Currency)</td>
                            <td class="text-end money">@SettlementFormat.Money(total.Refunds, total.Currency)</td>
                            <td class="text-end money">@SettlementFormat.Money(total.Expenses, total.Currency)</td>
                            @if (anyReserve)
                            {
                                <td class="text-end money">@SettlementFormat.Money(total.Reserve, total.Currency)</td>
                            }
                            <td class="text-end money">@SettlementFormat.Money(total.Net, total.Currency)</td>
                            @if (anyDeferred)
                            {
                                <td class="text-end money">@(Model.DeferredOut is { } footHeld ? SettlementFormat.Money(footHeld.Amount, footHeld.Currency) : "")</td>
                            }
                        </tr>
                    </tfoot>
                }
            </table>
        </div>
    }
</div>
<partial name="_Pager" model="Model.Rows.ToPager(Model.Search, Model.CurrentFilters())" />

@if (anyDeferred)
{
    @* Every SKU and price Amazon held back, including any with nothing paid in this settlement (so no row above). *@
    <details class="card mt-3 deferred-by-sku">
        <summary class="card-toolbar">
            <span class="card-toolbar-title">
                <partial name="_Icon" model='"clock"' />
                Deferred out of this payout by SKU
                <span class="text-muted-token fw-normal">· @Model.SkuDeferrals.Count.ToString("N0", CultureInfo.InvariantCulture) row@(Model.SkuDeferrals.Count == 1 ? "" : "s")</span>
            </span>
        </summary>
        <div class="table-responsive">
            <table class="table data-table align-middle mb-0">
                <thead>
                    <tr>
                        <th>SKU</th>
                        <th class="text-end">Price each</th>
                        <th class="text-end">Units</th>
                        <th class="text-end">Orders</th>
                        <th class="text-end">Deferred</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model.SkuDeferrals.OrderByDescending(d => d.Amount))
                    {
                        <tr>
                            @* Plain text: a SKU and price with nothing paid in this settlement has no Lines page. *@
                            <td class="fw-semibold">@(d.Sku ?? "No SKU")</td>
                            <td class="text-end money">@(d.PriceEach is { } each ? SettlementFormat.Money(each, s.Currency) : "")</td>
                            <td class="text-end money">@d.Quantity.ToString("N0", CultureInfo.InvariantCulture)</td>
                            <td class="text-end money">@d.Orders.ToString("N0", CultureInfo.InvariantCulture)</td>
                            <td class="text-end money fw-semibold">@SettlementFormat.Money(d.Amount, d.Currency)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </details>
}
