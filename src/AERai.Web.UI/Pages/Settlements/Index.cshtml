@page
@using System.Globalization
@using AERai.Web.Application.Settlements
@model AERai.Web.UI.Pages.Settlements.IndexModel
@{
    ViewData["Title"] = "Settlements";
    var t = Model.Totals;
    var currency = Model.Marketplace.Currency;
    var rows = Model.Settlements.Items;
    var anyConverted = rows.Any(r => r.Currency is not null && r.Currency != r.HomeCurrency);
}

@* ---------- Totals for what the search and filters select (all pages) ---------- *@
<div class="row g-3 mb-3">
    <div class="col-6 col-xl-3">
        <a class="card tile h-100" href="@Model.SortLink(SettlementSort.Net)">
            <div class="kpi">
                <div class="kpi-label">Net payouts <partial name="_Tip" model='"What Amazon paid out for the settlements listed (every page): sales, less fees and refunds, plus everything else. Payouts in CAD or MXN count at their converted amount. Click to sort by payout."' /></div>
                <div class="kpi-value">@DashboardFormat.Money(t.Net, currency)</div>
                <div class="kpi-foot">@t.Count.ToString("N0", CultureInfo.InvariantCulture) settlement@(t.Count == 1 ? "" : "s"), in @currency</div>
            </div>
        </a>
    </div>
    <div class="col-6 col-xl-3">
        <a class="card tile h-100" href="@Model.SortLink(SettlementSort.Sales)">
            <div class="kpi">
                <div class="kpi-label">Sales <partial name="_Tip" model='"Item price amounts on orders in these settlements. Click to sort by sales."' /></div>
                <div class="kpi-value">@DashboardFormat.Money(t.Sales, currency)</div>
                <div class="kpi-foot">Other: @DashboardFormat.Money(t.Other, currency)</div>
            </div>
        </a>
    </div>
    <div class="col-6 col-xl-3">
        <a class="card tile h-100" href="@Model.SortLink(SettlementSort.Fees)">
            <div class="kpi">
                <div class="kpi-label">Fees <partial name="_Tip" model='"Selling and fulfillment fees Amazon kept. Click to sort by fees, largest first."' /></div>
                <div class="kpi-value">@DashboardFormat.Money(t.Fees, currency)</div>
                <div class="kpi-foot">@(t.FeeRate is { } fr ? $"{SettlementFormat.Percent(fr)} of sales" : "No sales")</div>
            </div>
        </a>
    </div>
    <div class="col-6 col-xl-3">
        <a class="card tile h-100 @(t.RefundRate > 0.1m ? "tile-bad" : "")" href="@Model.SortLink(SettlementSort.Refunds)">
            <div class="kpi">
                <div class="kpi-label">Refunds <partial name="_Tip" model='"Money returned to customers. Click to sort by refunds, largest first."' /></div>
                <div class="kpi-value">@DashboardFormat.Money(t.Refunds, currency)</div>
                <div class="kpi-foot">@(t.RefundRate is { } rr ? $"{SettlementFormat.Percent(rr)} of sales" : "No sales")</div>
            </div>
        </a>
    </div>
</div>

@if (t.AwaitingRate > 0)
{
    <div class="page-footnote mt-n2 mb-3 d-flex flex-wrap align-items-center gap-2">
        <span>
            <span class="pill pill-warn">No rate yet</span>
            @t.AwaitingRate.ToString("N0", CultureInfo.InvariantCulture) settlement@(t.AwaitingRate == 1 ? " was" : "s were") paid in another currency and @(t.AwaitingRate == 1 ? "has" : "have") no exchange rate yet, so @(t.AwaitingRate == 1 ? "it is" : "they are") listed as paid but not added to the totals.
        </span>
        @if (Model.CanEdit)
        {
            <form method="post" asp-page="Rates" asp-page-handler="Fetch" asp-route-back="@Request.QueryString">
                <button type="submit" class="btn btn-sm btn-soft">Fetch missing rates</button>
            </form>
        }
    </div>
}

@* ---------- Search + period + currency filters ---------- *@
<div class="list-toolbar mb-3">
    <form method="get" class="filters" data-autosubmit-form role="search">
        @if (Model.Sort != SettlementSort.PeriodEnd)
        {
            <input type="hidden" name="sort" value="@Model.Sort" />
        }
        @if (Model.Descending)
        {
            <input type="hidden" name="desc" value="true" />
        }
        <div class="search-box">
            <partial name="_Icon" model='"search"' />
            <input type="search" name="q" value="@Model.Search" class="form-control form-control-sm" placeholder="Search settlement, order, SKU, ASIN…" aria-label="Search settlements" />
        </div>
        <label class="filter-label" for="settlement-from">Period ends</label>
        <input type="date" id="settlement-from" name="from" value="@Model.From?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" class="form-control form-control-sm date-filter" aria-label="Period ends on or after" data-autosubmit />
        <span class="text-muted-token" aria-hidden="true">–</span>
        <input type="date" name="to" value="@Model.To?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" class="form-control form-control-sm date-filter" aria-label="Period ends on or before" data-autosubmit />
        @if (Model.Currencies.Count > 1 || Model.Currency is not null)
        {
            <select name="currency" class="form-select form-select-sm" aria-label="Paid in">
                <option value="">Paid in any currency</option>
                @foreach (var c in Model.Currencies)
                {
                    <option value="@c" selected="@(Model.Currency == c)">Paid in @c (@SettlementOrigin.FromCurrency(c))</option>
                }
            </select>
        }
        <button type="submit" class="btn btn-sm btn-soft js-hide">Apply</button>
        @if (Model.IsFiltered)
        {
            <a asp-page="Index" class="btn btn-sm btn-link">Clear filters</a>
        }
    </form>
</div>

@* ---------- Settlement list ---------- *@
<div class="card">
    <div class="card-toolbar">
        <span class="card-toolbar-title list-count">
            <span class="text-nowrap">@Model.Settlements.TotalCount.ToString("N0", CultureInfo.InvariantCulture) settlement@(Model.Settlements.TotalCount == 1 ? "" : "s")</span>
            <span class="text-muted-token fw-normal">in @Model.Marketplace.Name@(Model.Currency is null ? "" : " · " + Model.Currency)</span>
            <partial name="_Tip" model='"One row per Amazon payout. Amazon lists every North America payout here: CAD (CA) and MXN (MX) ones are shown in USD at the rate of their deposit date, with the amount as paid beside it. Open one to see it by SKU and price, then the orders behind each row."' />
        </span>
    </div>
    @if (rows.Count == 0)
    {
        <div class="empty-state">
            @if (Model.IsFiltered)
            {
                <div class="empty-title">No settlements match</div>
                <div class="empty-detail">Try a different search or period.</div>
                <a asp-page="Index" class="btn btn-sm btn-soft">Clear filters</a>
            }
            else
            {
                <div class="empty-title">No settlements yet</div>
                @if (Model.ListedUnder is { } home)
                {
                    <div class="empty-detail">Amazon pays every North America marketplace out together, so @Model.Marketplace.Name's payouts are listed under @home.Name, converted into @home.Currency and tagged @Model.Marketplace.Code.</div>
                }
                else
                {
                    <div class="empty-detail">Payouts appear once the settlement sync runs for @Model.Marketplace.Name, or after you import a settlement file.</div>
                    <a asp-page="/Tools/Schedules/Index" class="btn btn-sm btn-soft"><partial name="_Icon" model='"plug"' /> Amazon sync</a>
                }
            }
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table data-table settlement-table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Settlement</th>
                        <th><a href="@Model.SortLink(SettlementSort.PeriodEnd)" class="sort-link">Period @Model.SortArrow(SettlementSort.PeriodEnd)</a></th>
                        <th class="text-end"><a href="@Model.SortLink(SettlementSort.Sales)" class="sort-link">Sales @Model.SortArrow(SettlementSort.Sales)</a></th>
                        <th class="text-end"><a href="@Model.SortLink(SettlementSort.Fees)" class="sort-link">Fees @Model.SortArrow(SettlementSort.Fees)</a></th>
                        <th class="text-end"><a href="@Model.SortLink(SettlementSort.Refunds)" class="sort-link">Refunds @Model.SortArrow(SettlementSort.Refunds)</a></th>
                        <th class="text-end">Other</th>
                        <th class="text-end"><a href="@Model.SortLink(SettlementSort.Net)" class="sort-link">Net payout @Model.SortArrow(SettlementSort.Net)</a></th>
                        @if (anyConverted)
                        {
                            <th class="text-end">As paid <partial name="_Tip" model='"The net payout in the currency Amazon paid it in, before conversion."' /></th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in rows)
                    {
                        var m = SettlementMoney.Of(s, SettlementAmounts.Home);
                        var foreign = s.Currency is not null && s.Currency != s.HomeCurrency;
                        <tr>
                            <td>
                                <a asp-page="Summary" asp-route-id="@s.SettlementId" class="fw-semibold">@s.SettlementId</a>
                                @if (foreign)
                                {
                                    <span class="@SettlementFormat.OriginPill(SettlementOrigin.FromCurrency(s.Currency)) ms-1" title="Paid in @s.Currency">@SettlementOrigin.FromCurrency(s.Currency)</span>
                                }
                            </td>
                            <td class="text-nowrap">@SettlementFormat.Period(s.PeriodStart, s.PeriodEnd)</td>
                            <td class="text-end money">@SettlementFormat.Money(m.Sales, m.Currency)</td>
                            <td class="text-end money @SettlementFormat.AmountClass(m.Fees)">@SettlementFormat.Money(m.Fees, m.Currency)</td>
                            <td class="text-end money @SettlementFormat.AmountClass(m.Refunds)">@SettlementFormat.Money(m.Refunds, m.Currency)</td>
                            <td class="text-end money @SettlementFormat.AmountClass(m.Other)">@SettlementFormat.Money(m.Other, m.Currency)</td>
                            <td class="text-end money fw-semibold @SettlementFormat.AmountClass(m.Net)">@SettlementFormat.Money(m.Net, m.Currency)</td>
                            @if (anyConverted)
                            {
                                <td class="text-end money text-nowrap">
                                    @if (foreign && s.ExchangeRate is null)
                                    {
                                        <span class="pill pill-warn">No rate yet</span>
                                    }
                                    else if (foreign)
                                    {
                                        <span class="text-muted-token" title="@SettlementFormat.RateTitle(s)">@SettlementFormat.Money(s.Net, s.Currency)</span>
                                    }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
<partial name="_Pager" model="Model.Settlements.ToPager(Model.Search, Model.CurrentFilters())" />
