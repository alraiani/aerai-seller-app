@using AERai.Web.UI.Models
@model (decimal Sales, decimal Fees, decimal Refunds, decimal Other, decimal Net, string? Currency)
@* The four columns that make up a net amount, as a compact strip: Sales − Fees − Refunds ± Other = Net. *@
<dl class="amount-breakdown">
    <div><dt>Sales</dt><dd>@SettlementFormat.Money(Model.Sales, Model.Currency)</dd></div>
    <div><dt>Fees</dt><dd class="@SettlementFormat.AmountClass(Model.Fees)">@SettlementFormat.Money(Model.Fees, Model.Currency)</dd></div>
    <div><dt>Refunds</dt><dd class="@SettlementFormat.AmountClass(Model.Refunds)">@SettlementFormat.Money(Model.Refunds, Model.Currency)</dd></div>
    <div><dt>Other</dt><dd class="@SettlementFormat.AmountClass(Model.Other)">@SettlementFormat.Money(Model.Other, Model.Currency)</dd></div>
    <div class="amount-breakdown-total"><dt>Net</dt><dd class="@SettlementFormat.AmountClass(Model.Net)">@SettlementFormat.Money(Model.Net, Model.Currency)</dd></div>
</dl>
