@page "{id}"
@model AERai.Web.UI.Pages.Settlements.LinesModel
@{
    var g = Model.Group;
    ViewData["Title"] = $"{g.Sku ?? "No SKU"} · settlement {g.SettlementId}";
}

@* The breadcrumb shows the price in the chosen amounts, so it reloads with the rest (site.js partial reloads). *@
<div data-fragment="settlement-lines">
    <partial name="_LinesBody" />
</div>
