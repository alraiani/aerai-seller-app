@page "{id}"
@model AERai.Web.UI.Pages.Bookkeeping.SettlementModel
@{
    ViewData["Title"] = "Review & export";
    var p = Model.Preview;
}
<nav class="crumbs" aria-label="Breadcrumb">
    <a asp-page="Index">QuickBooks export</a>
    <span aria-hidden="true">/</span>
    <span>Settlement @p.SettlementId</span>
</nav>
<div class="card mb-3">
    <div class="card-body">
        <h2 class="h6">Settlement @p.SettlementId</h2>
        <p class="mb-1">Period @SettlementFormat.Period(p.PeriodStart, p.PeriodEnd, Model.Zone). Net payout <strong>@SettlementFormat.Money(p.NetTotal, p.Currency)</strong>.</p>
        @if (p.IsConverted)
        {
            <p class="mb-1">Paid in @p.OriginalCurrency: @SettlementFormat.Money(p.OriginalNetTotal ?? 0, p.OriginalCurrency) × @p.ExchangeRate?.ToString("0.######") (@p.RateNote) = @SettlementFormat.Money(p.NetTotal, p.Currency). The entry is written in @p.Currency.</p>
            @if (p.RoundingAdjustment != 0)
            {
                <p class="mb-1 text-body-secondary small">Each account is converted and rounded to the cent; the @p.RoundingAdjustment.ToString("0.00") @p.Currency left over is added to the largest account line so the entry balances.</p>
            }
        }
        <p class="mb-0 text-body-secondary">Deposit account: @(p.HasDepositAccount ? p.DepositAccountName : "not set")</p>
    </div>
</div>

@if (p.NeedsRate)
{
    <div class="alert alert-warning">This settlement was paid in @p.Currency and has no exchange rate yet, so it can't be exported in the books' currency. Fetch the rate or enter it on the <a asp-page="/Settlements/Summary" asp-route-id="@p.SettlementId">settlement's page</a>.</div>
}
@if (!p.HasDepositAccount)
{
    <div class="alert alert-warning">Set this marketplace's deposit account on the <a asp-page="Mapping">Account mapping</a> page.</div>
}
@if (p.HasUnmapped)
{
    <div class="alert alert-warning">
        @p.Unmapped.Count kind@(p.Unmapped.Count == 1 ? "" : "s") of amount @(p.Unmapped.Count == 1 ? "has" : "have") no QuickBooks account yet.
        Map @(p.Unmapped.Count == 1 ? "it" : "them") on the <a asp-page="Mapping">Account mapping</a> page.
    </div>
}

<div class="card mb-3">
    <div class="card-body p-0">
        <div class="table-responsive">
        <table class="table table-sm mb-0">
            <thead>
                <tr><th>Amount type</th><th>Description</th><th>QuickBooks account</th>@if (p.IsConverted)
                    {
                        <th class="text-end">@p.OriginalCurrency</th>
                    }<th class="text-end">Amount@(p.IsConverted ? $" ({p.Currency})" : "")</th></tr>
                <tr class="totals-row"><th colspan="3">Net payout</th>@if (p.IsConverted)
                    {
                        <th class="text-end money text-body-secondary">@SettlementFormat.Money(p.OriginalNetTotal ?? 0, p.OriginalCurrency)</th>
                    }<th class="text-end money">@SettlementFormat.Money(p.NetTotal, p.Currency)</th></tr>
            </thead>
            <tbody>
            @foreach (var r in p.Rows)
            {
                <tr>
                    <td>@r.AmountType</td>
                    <td>@r.AmountDescription</td>
                    <td>
                        @if (string.IsNullOrWhiteSpace(r.QuickBooksAccountName))
                        {
                            <span class="pill pill-bad">Unmapped</span>
                        }
                        else
                        {
                            @r.QuickBooksAccountName
                        }
                    </td>
                    @if (p.IsConverted)
                    {
                        <td class="text-end money text-body-secondary">@SettlementFormat.Money(r.Amount, p.OriginalCurrency)</td>
                    }
                    <td class="text-end money">@SettlementFormat.Money(p.IsConverted ? r.HomeAmount ?? 0 : r.Amount, p.Currency)</td>
                </tr>
            }
            @if (p.Rows.Count == 0)
            {
                <tr><td colspan="@(p.IsConverted ? 5 : 4)" class="text-body-secondary p-3">This settlement has no lines.</td></tr>
            }
            </tbody>
        </table>
        </div>
    </div>
</div>

@if (Model.PreviousExports.Count > 0)
{
    var last = Model.PreviousExports[0];
    var en = System.Globalization.CultureInfo.GetCultureInfo("en-US");
    <div class="notice notice-warn mb-3" role="note">
        <partial name="_Icon" model='"history"' />
        <div>
            Already exported @(Model.PreviousExports.Count == 1 ? "once" : $"{Model.PreviousExports.Count} times"): last on
            @TimeZoneInfo.ConvertTime(last.GeneratedAt, Model.Zone).ToString("MMM d, yyyy h:mm tt", en) by @last.GeneratedBy
            (<a asp-page="Index" asp-page-handler="Download" asp-route-id="@last.Id">@last.FileName</a>).
            Importing it into QuickBooks again would record this payout twice.
        </div>
    </div>
}
@* A re-export asks first; the button's own question takes over from the form's (site.js). *@
<form method="post" asp-page-handler="Export" asp-route-id="@p.SettlementId">
    <button type="submit" class="btn btn-primary" disabled="@(!p.CanExport)"
            data-confirm="@(Model.PreviousExports.Count > 0 ? $"Settlement {p.SettlementId} was already exported. Create another IIF file anyway?" : null)">@(Model.PreviousExports.Count > 0 ? "Export again" : "Export IIF file")</button>
    <a asp-page="Index" class="btn btn-link">Back</a>
</form>
