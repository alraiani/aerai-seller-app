@page
@model AERai.Web.UI.Pages.Bookkeeping.IndexModel
@{
    ViewData["Title"] = "QuickBooks export";
}
<div class="card-toolbar">
    <p class="text-body-secondary mb-0">Review a settlement, then download it as a QuickBooks Desktop IIF journal entry. Every kind of amount needs a QuickBooks account first.</p>
    <a asp-page="Mapping" class="btn btn-outline-secondary btn-sm">Account mapping</a>
</div>
@* Search and the pager reload only this list (site.js partial reloads). *@
<div data-fragment="bookkeeping-settlements">
    <partial name="_SettlementsBody" />
</div>

<h2 class="h6 mt-4">Generated files</h2>
<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
        <table class="table table-sm table-hover mb-0">
            <thead>
                <tr><th>File</th><th>Settlement</th><th class="text-end">Net payout</th><th>Generated</th><th>By</th><th></th></tr>
            </thead>
            <tbody>
            @foreach (var e in Model.Exports)
            {
                <tr>
                    <td class="cell-truncate" title="@e.FileName">@e.FileName</td>
                    <td><a asp-page="Settlement" asp-route-id="@e.SettlementId">@e.SettlementId</a></td>
                    <td class="text-end money">@SettlementFormat.Money(e.NetTotal, e.Currency)</td>
                    <td class="text-nowrap">@TimeZoneInfo.ConvertTime(e.GeneratedAt, Model.Zone).ToString("MMM d, yyyy h:mm tt", System.Globalization.CultureInfo.GetCultureInfo("en-US"))</td>
                    <td>@e.GeneratedBy</td>
                    <td class="text-end"><a asp-page="Index" asp-page-handler="Download" asp-route-id="@e.Id" class="btn btn-sm btn-outline-secondary">Download</a></td>
                </tr>
            }
            @if (Model.Exports.Count == 0)
            {
                <tr><td colspan="6" class="text-body-secondary p-3">Nothing exported yet.</td></tr>
            }
            </tbody>
        </table>
        </div>
    </div>
</div>
