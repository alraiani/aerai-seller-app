@page "{sku}"
@model AERai.Web.UI.Pages.Products.EditModel
@{
    ViewData["Title"] = "Edit cost of goods";
}
<nav class="crumbs" aria-label="Breadcrumb">
    <a asp-page="Index">Products &amp; COGS</a>
    <span aria-hidden="true">/</span>
    <span>@Model.Product.Sku</span>
</nav>
<div class="card col-lg-6">
    <div class="card-body">
        <h2 class="h6">@Model.Product.Sku <span class="pill pill-muted ms-1">@Model.Marketplace.Code</span></h2>
        <p class="text-body-secondary">@Model.Product.Title</p>
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
            <div class="mb-3">
                <label asp-for="Input.CostOfGoods" class="form-label"></label>
                <input asp-for="Input.CostOfGoods" class="form-control" step="0.01" min="0" />
                <span asp-validation-for="Input.CostOfGoods" class="text-danger small"></span>
                <div class="form-text">Landed cost per unit in @Model.Marketplace.Name, in @Model.Marketplace.Currency. Other marketplaces keep their own cost. Leave blank to clear.</div>
            </div>
            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-page="Index" class="btn btn-link">Cancel</a>
        </form>
    </div>
</div>
@if (Model.History.Count > 0)
{
    <section class="card col-lg-6 mt-3" aria-labelledby="cost-history-title">
        <div class="card-toolbar">
            <h2 id="cost-history-title" class="card-toolbar-title">Cost history</h2>
        </div>
        <p class="text-body-secondary small px-3 mb-2">Profit &amp; loss charges each sale the cost in effect on its order date, so a new cost never changes past profit.</p>
        <div class="table-responsive">
            <table class="table data-table align-middle mb-0">
                <thead>
                    <tr>
                        <th scope="col">From</th>
                        <th scope="col" class="text-end">Cost</th>
                        <th scope="col">Saved by</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var entry in Model.History)
                    {
                        <tr>
                            <td>@(entry.ChangedBy == "system" ? "Before history began" : TimeZoneInfo.ConvertTime(entry.EffectiveFrom, Model.TimeZone).ToString("MMM d, yyyy h:mm tt"))</td>
                            <td class="text-end">@(entry.CostOfGoods is { } cost ? DashboardFormat.Price(cost, Model.Marketplace.Currency) : "Cleared")</td>
                            <td>@entry.ChangedBy</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
