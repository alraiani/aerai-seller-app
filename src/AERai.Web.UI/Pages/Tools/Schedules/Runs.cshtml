@page
@model AERai.Web.UI.Pages.Tools.Schedules.RunsModel
@{
    ViewData["Title"] = "Sync run history";
}
<nav class="crumbs" aria-label="Breadcrumb">
    <a asp-page="Index">Amazon sync</a>
    <span aria-hidden="true">/</span>
    <span>Run history@(Model.ScheduleId is { } sid ? $" · {Model.ScheduleNames.GetValueOrDefault(sid, $"#{sid}")}" : "")</span>
</nav>
<div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-3">
    @if (Model.AnyRunning)
    {
        <div class="auto-refresh" data-auto-refresh="10">
            <span class="status-light status-running" aria-hidden="true"></span>
            <span>A run is in progress — refreshing every 10 s.</span>
            <button type="button" class="btn btn-sm btn-link p-0" data-auto-refresh-stop>Stop</button>
        </div>
    }
    else
    {
        <span></span>
    }
    <div class="d-flex gap-2">
        @if (Model.ScheduleId is not null)
        {
            <a asp-page="Runs" class="btn btn-sm btn-soft">All schedules</a>
        }
        <a asp-page="Runs" asp-route-scheduleId="@Model.ScheduleId" class="btn btn-sm btn-soft"><partial name="_Icon" model='"refresh"' /> Refresh</a>
    </div>
</div>
<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
            <thead><tr><th>#</th><th>Schedule</th><th>Trigger</th><th>Started (UTC)</th><th>Duration</th><th>Status</th><th>Batches</th><th>Details</th></tr></thead>
            <tbody>
            @foreach (var r in Model.Runs.Items)
            {
                <tr>
                    <td>@r.Id</td>
                    <td>@Model.ScheduleNames.GetValueOrDefault(r.SyncScheduleId, $"#{r.SyncScheduleId}")</td>
                    <td>@r.Trigger<div class="cell-sub">@r.TriggeredBy</div></td>
                    <td>@r.StartedAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
                    <td>@(r.CompletedAt is { } done ? $"{(done - r.StartedAt).TotalSeconds:0}s" : "running…")</td>
                    <td><span class="@ScheduleDisplay.StatusPill(r.Status)">@ScheduleDisplay.StatusLabel(r.Status)</span></td>
                    <td>
                        @foreach (var batchId in (r.ImportBatchIds ?? string.Empty).Split(',', StringSplitOptions.RemoveEmptyEntries))
                        {
                            <a asp-page="/Tools/Batches/Details" asp-route-id="@batchId" class="me-1">@batchId</a>
                        }
                    </td>
                    <td class="small">
                        @if (r.DataStart is { } ds && r.DataEnd is { } de)
                        {
                            <div class="cell-sub">Window @ds.UtcDateTime.ToString("yyyy-MM-dd HH:mm") → @de.UtcDateTime.ToString("yyyy-MM-dd HH:mm") UTC</div>
                        }
                        @r.Message
                        @if (r.AmazonReportIds is not null)
                        {
                            <div class="cell-sub">Amazon report: @r.AmazonReportIds</div>
                        }
                    </td>
                </tr>
            }
            @if (Model.Runs.Items.Count == 0)
            {
                <tr><td colspan="8" class="text-body-secondary p-3">No runs yet.</td></tr>
            }
            </tbody>
        </table>
        </div>
    </div>
</div>
<partial name="_Pager" model="Model.Runs.ToPager(Model.Search)" />

@section Scripts {
    <script src="~/js/schedules.js" asp-append-version="true"></script>
}
