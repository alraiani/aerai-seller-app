@page
@model AERai.Web.UI.Pages.Tools.Schedules.RunsModel
@using AERai.Web.Domain.Ingestion
@{
    ViewData["Title"] = "Sync run history";
}
<nav class="crumbs" aria-label="Breadcrumb">
    <a asp-page="Index">Amazon sync</a>
    <span aria-hidden="true">/</span>
    <span>Run history</span>
</nav>
@if (Model.AnyRunning)
{
    <div class="auto-refresh mb-3" data-auto-refresh="10">
        <span class="status-light status-running" aria-hidden="true"></span>
        <span>A run is in progress — refreshing every 10 s.</span>
        <button type="button" class="btn btn-sm btn-link p-0" data-auto-refresh-stop>Stop</button>
    </div>
}

@* The schedule filter and the pager reload only this section (site.js partial reloads). *@
<div data-fragment="runs">
    <partial name="_RunsBody" />
</div>

@section Scripts {
    <script src="~/js/schedules.js" asp-append-version="true"></script>
}
