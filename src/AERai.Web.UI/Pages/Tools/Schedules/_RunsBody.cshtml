@model AERai.Web.UI.Pages.Tools.Schedules.RunsModel
@using AERai.Web.Domain.Ingestion
@{
    var items = Model.Runs.Items;
    var filters = Model.ScheduleId is { } id ? new Dictionary<string, string> { ["scheduleId"] = id.ToString(System.Globalization.CultureInfo.InvariantCulture) } : null;
}
<div class="card">
    <div class="card-toolbar">
        <span class="card-toolbar-title list-count">
            <span class="text-nowrap">@Model.Runs.TotalCount.ToString("N0") run@(Model.Runs.TotalCount == 1 ? "" : "s")</span>
            <span class="text-muted-token fw-normal">· times in @ZoneFormat.Name(Model.TimeZoneId)</span>
        </span>
        <div class="card-toolbar-group">
            <form method="get" class="filters" data-autosubmit-form>
                <select name="scheduleId" class="form-select form-select-sm" aria-label="Schedule">
                    <option value="">All schedules</option>
                    @foreach (var (scheduleId, name) in Model.ScheduleNames.OrderBy(n => n.Value, StringComparer.OrdinalIgnoreCase))
                    {
                        <option value="@scheduleId" selected="@(Model.ScheduleId == scheduleId)">@name</option>
                    }
                </select>
                <button type="submit" class="btn btn-sm btn-soft js-hide">Show</button>
            </form>
            <a asp-page="Runs" asp-route-scheduleId="@Model.ScheduleId" class="btn btn-sm btn-soft"><partial name="_Icon" model='"refresh"' /> Refresh</a>
        </div>
    </div>
    @if (items.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-title">@(Model.ScheduleId is null ? "No runs yet" : "No runs of this schedule yet")</div>
            <div class="empty-detail">Runs appear here once a schedule runs, from its timetable or from Run now.</div>
            <a asp-page="Index" class="btn btn-sm btn-soft" data-fragment-skip>Amazon sync</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table data-table align-middle mb-0">
                <thead>
                    <tr>
                        <th scope="col">#</th>
                        <th scope="col">Schedule</th>
                        <th scope="col">Trigger</th>
                        <th scope="col">Started</th>
                        <th scope="col">Took</th>
                        <th scope="col">Status</th>
                        <th scope="col">Batches</th>
                        <th scope="col">Details</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var r in items)
                {
                    <tr>
                        <td>@r.Id</td>
                        <td>@Model.ScheduleNames.GetValueOrDefault(r.SyncScheduleId, $"#{r.SyncScheduleId}")</td>
                        <td>@r.Trigger<div class="cell-sub">@r.TriggeredBy</div></td>
                        <td class="text-nowrap"><span class="has-detail" title="@ScheduleDisplay.Local(r.StartedAt, Model.TimeZoneId)">@ScheduleDisplay.Relative(r.StartedAt, Model.Now)</span></td>
                        <td class="text-nowrap">@(r.CompletedAt is { } done ? ScheduleDisplay.Duration(done - r.StartedAt) : "running…")</td>
                        <td>
                            <span class="@ScheduleDisplay.StatusPill(r.Status)">@(ScheduleDisplay.IsWaiting(r) ? "Waiting on Amazon" : ScheduleDisplay.StatusLabel(r.Status))</span>
                            @if (r.Status == SyncRunStatus.Running)
                            {
                                <form method="post" asp-page-handler="Stop" asp-route-runId="@r.Id" asp-route-scheduleId="@Model.ScheduleId" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-link p-0 ms-1 text-bad" data-confirm="Stop run #@r.Id? A report Amazon hasn't started is cancelled there too; anything already saved is kept."
                                            aria-label="Stop run #@r.Id"><partial name="_Icon" model='"stop"' /> Stop</button>
                                </form>
                            }
                        </td>
                        <td>
                            @foreach (var batchId in (r.ImportBatchIds ?? string.Empty).Split(',', StringSplitOptions.RemoveEmptyEntries))
                            {
                                <a asp-page="/Tools/Batches/Details" asp-route-id="@batchId" class="me-1" data-fragment-skip>@batchId</a>
                            }
                        </td>
                        <td class="small">
                            @if (r.DataStart is { } ds && r.DataEnd is { } de)
                            {
                                <div class="cell-sub">Window @ScheduleDisplay.Local(ds, Model.TimeZoneId) → @ScheduleDisplay.Local(de, Model.TimeZoneId)</div>
                            }
                            @r.Message
                            @if (r.AmazonReportIds is not null)
                            {
                                <div class="cell-sub">Amazon report: @r.AmazonReportIds</div>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
<partial name="_Pager" model="Model.Runs.ToPager(Model.Search, filters)" />
