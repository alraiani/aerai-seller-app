@page
@model AERai.Web.UI.Pages.Admin.Users.IndexModel
@{
    ViewData["Title"] = "Users";
    var filtered = !string.IsNullOrWhiteSpace(Model.Search);
}
<div class="card">
    <div class="card-toolbar">
        <span class="card-toolbar-title list-count">
            <span class="text-nowrap">@(filtered ? $"{Model.Users.Count} of {Model.TotalUsers}" : Model.TotalUsers.ToString("N0")) user@(Model.TotalUsers == 1 ? "" : "s")</span>
            <partial name="_Tip" model='"Admin: users and everything. Operator: imports, Amazon sync, costs, bookkeeping. Viewer: read-only. Locking signs someone out until unlocked."' />
        </span>
        <div class="card-toolbar-group">
            <form method="get" class="filters" role="search">
                <div class="search-box">
                    <partial name="_Icon" model='"search"' />
                    <input type="search" name="q" value="@Model.Search" class="form-control form-control-sm" placeholder="Search name, email, role…" aria-label="Search users" />
                </div>
                <button type="submit" class="btn btn-sm btn-soft js-hide">Search</button>
                @if (filtered)
                {
                    <a asp-page="Index" class="btn btn-sm btn-link">Clear</a>
                }
            </form>
            <a asp-page="Create" class="btn btn-sm btn-primary"><partial name="_Icon" model='"plus"' /> New user</a>
        </div>
    </div>
    @if (Model.Users.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-title">@(filtered ? $"No users match “{Model.Search}”" : "No users yet")</div>
            @if (filtered)
            {
                <a asp-page="Index" class="btn btn-sm btn-soft">Clear search</a>
            }
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table data-table align-middle mb-0">
                <thead><tr><th scope="col">Name</th><th scope="col">Email</th><th scope="col">Roles</th><th scope="col">Status</th><th scope="col"><span class="visually-hidden">Actions</span></th></tr></thead>
                <tbody>
                @foreach (var u in Model.Users)
                {
                    var isMe = u.Id == Model.CurrentUserId;
                    <tr>
                        <td class="fw-semibold">@u.DisplayName<span class="cell-sub fw-normal ms-1">@(isMe ? "(you)" : "")</span></td>
                        <td>@u.Email</td>
                        <td>@string.Join(", ", u.Roles)</td>
                        <td><span class="pill @(u.IsLockedOut ? "pill-bad" : "pill-ok")">@(u.IsLockedOut ? "Locked" : "Active")</span></td>
                        <td class="text-end">
                            @if (!isMe)
                            {
                                <form method="post" asp-page-handler="SetLockout" asp-route-userId="@u.Id" asp-route-locked="@(!u.IsLockedOut)"
                                      data-confirm="@(u.IsLockedOut ? null : $"Lock {u.Email}? They are signed out and can't sign in until unlocked.")">
                                    <button type="submit" class="btn btn-sm @(u.IsLockedOut ? "btn-soft-ok" : "btn-soft-bad")" aria-label="@(u.IsLockedOut ? "Unlock" : "Lock") @u.Email">@(u.IsLockedOut ? "Unlock" : "Lock")</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
