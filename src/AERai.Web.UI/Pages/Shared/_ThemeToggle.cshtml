@* Three-way theme switch (Light / System / Dark). Behavior lives in wwwroot/js/theme.js. *@
<div class="theme-toggle" role="group" aria-label="Color theme">
    <button type="button" class="theme-toggle-btn" data-theme-option="light" title="Light" aria-label="Light theme">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
    </button>
    <button type="button" class="theme-toggle-btn" data-theme-option="auto" title="Match system" aria-label="Match system theme">
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="12" rx="2" /><path d="M8 20h8M12 16v4" /></svg>
    </button>
    <button type="button" class="theme-toggle-btn" data-theme-option="dark" title="Dark" aria-label="Dark theme">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" /></svg>
    </button>
</div>
