@{
    var isSignedIn = User.Identity?.IsAuthenticated == true;
}
<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    @* Must run before the stylesheets paint to avoid a light-mode flash for dark-theme users. *@
    <script src="~/js/theme.js" asp-append-version="true"></script>
    <title>@ViewData["Title"] · AERai Seller</title>
    <link rel="icon" href="~/favicon.ico" sizes="16x16 32x32 48x48" asp-append-version="true" />
    <link rel="apple-touch-icon" href="~/img/apple-touch-icon.png" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
@if (isSignedIn)
{
    <div class="app-shell">
        <partial name="_Sidebar" />
        <div class="app-main">
            <header class="app-topbar">
                <h1 class="h5 mb-0">@ViewData["Title"]</h1>
                <div class="topbar-actions">
                    <partial name="_NotificationBell" />
                    <partial name="_MarketplaceSwitch" />
                    <partial name="_ThemeToggle" />
                    <a asp-page="/Account/ChangePassword" class="text-body-secondary small d-none d-md-inline" title="Change password">@User.Identity!.Name</a>
                    <form method="post" asp-page="/Account/Logout">
                        <button type="submit" class="btn btn-sm btn-outline-secondary">Sign out</button>
                    </form>
                </div>
            </header>
            <main class="app-content" role="main">
                <partial name="_StatusMessage" />
                @RenderBody()
            </main>
        </div>
    </div>
}
else
{
    <main role="main">
        <div class="login-theme"><partial name="_ThemeToggle" /></div>
        @RenderBody()
    </main>
}
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
