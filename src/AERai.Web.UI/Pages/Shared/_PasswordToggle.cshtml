@* Eye button that shows or hides the password typed in the input just before it (inside the same .input-group).
   site.js does the toggling; without script the button stays hidden and the field works as usual. *@
<button type="button" class="btn btn-outline-secondary password-toggle" data-password-toggle aria-label="Show password" aria-pressed="false" title="Show password">
    <span class="password-toggle-show"><partial name="_Icon" model="@("eye")" /></span>
    <span class="password-toggle-hide"><partial name="_Icon" model="@("eye-off")" /></span>
</button>
