@using AERai.Web.Application.Inventory
@using AERai.Web.Application.Security
@model InventoryItem
@{
    var p = Model.Position;
    var canEdit = User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.Operator);
}
@* Product cell for both Inventory views; the title links to Inventory → Edit for operators. *@
<partial name="_ProductCell" model='new AERai.Web.UI.Models.ProductCellModel(p.Sku, p.Asin, p.Title, p.Family, p.ImagePath, canEdit ? Url.Page("/Inventory/Edit", new { sku = p.Sku }) : null)' />
