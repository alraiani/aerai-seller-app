@page
@using System.Globalization
@model AERai.Web.UI.Pages.Inventory.HomeStock.IndexModel
@{
    ViewData["Title"] = "Edit home stock";
    var en = CultureInfo.GetCultureInfo("en-US");
}

<nav class="crumbs" aria-label="Breadcrumb">
    <a asp-page="../Index">Inventory</a>
    <span aria-hidden="true">/</span>
    <span>Edit home stock</span>
</nav>

<div class="list-toolbar mb-3">
    <form method="get" class="filters" role="search">
        <div class="search-box">
            <partial name="_Icon" model='"search"' />
            <input type="search" name="q" value="@Model.Search" class="form-control form-control-sm" placeholder="Search SKU, ASIN, name, family…" aria-label="Search SKUs" />
        </div>
        <button type="submit" class="btn btn-sm btn-soft js-hide">Search</button>
        @if (!string.IsNullOrWhiteSpace(Model.Search))
        {
            <a asp-page="Index" class="btn btn-sm btn-link">Clear</a>
        }
    </form>
    <div class="card-toolbar-group">
        <a asp-page="Upload" asp-page-handler="Template" class="btn btn-sm btn-soft"><partial name="_Icon" model='"download"' /> Download count sheet</a>
        <a asp-page="Upload" class="btn btn-sm btn-soft"><partial name="_Icon" model='"upload"' /> Upload a spreadsheet instead</a>
    </div>
</div>

@* data-dirty-form: typed counts show a save bar, and leaving (paging, searching) warns before they are lost. *@
<form method="post" asp-route-p="@Model.PageNumber" asp-route-q="@Model.Search" data-dirty-form>
    <div asp-validation-summary="All" class="alert alert-danger py-2"></div>
    <div class="card">
        <div class="card-toolbar">
            <span class="card-toolbar-title">
                Units held outside Amazon for @Model.Marketplace.Name
                <partial name="_Tip" model='"Change any numbers, then save once. Only changed rows are saved; 0 clears a SKU. SKUs appear here once Amazon reports them for this marketplace; for others, use the spreadsheet upload."' />
            </span>
        </div>
        @if (Model.Skus.Items.Count == 0)
        {
            var searched = !string.IsNullOrWhiteSpace(Model.Search);
            <div class="empty-state">
                <div class="empty-title">@(searched ? $"No SKUs match “{Model.Search}”" : "No SKUs at Amazon yet")</div>
                <div class="empty-detail">@(searched ? "Try a different search." : "SKUs appear once Amazon reports them for this marketplace.") Upload a spreadsheet for SKUs that aren't at Amazon yet.</div>
                @if (searched)
                {
                    <a asp-page="Index" class="btn btn-sm btn-soft">Clear search</a>
                }
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table data-table inventory-table align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="product-col">Product</th>
                            <th class="text-end">At Amazon</th>
                            <th class="text-end">Sold 30d</th>
                            <th class="text-end home-stock-col">Home stock</th>
                        </tr>
                    </thead>
                    <tbody>
                    @for (var i = 0; i < Model.Skus.Items.Count; i++)
                    {
                        var item = Model.Skus.Items[i];
                        var p = item.Position;
                        <tr>
                            <td class="product-col"><partial name="../_InventoryProduct" model="item" /></td>
                            <td class="text-end">@p.AmazonTotal.ToString("N0", en)</td>
                            <td class="text-end">@item.UnitsSold30d.ToString("N0", en)</td>
                            <td class="text-end">
                                <input type="hidden" name="Rows[@i].Sku" value="@p.Sku" />
                                <input type="hidden" name="Rows[@i].Original" value="@p.HomeStock" />
                                <input type="number" name="Rows[@i].Quantity" value="@Model.ValueFor(item)" data-original="@p.HomeStock" min="0" step="1" class="form-control form-control-sm text-end" aria-label="Home stock for @p.Sku" />
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
    @if (Model.Skus.Items.Count > 0)
    {
        <div class="save-bar" data-save-bar>
            <span class="text-muted-token" data-save-count>Change any counts, then save once.</span>
            <div class="d-flex flex-wrap align-items-center gap-2">
                <a asp-page="Index" asp-route-p="@Model.PageNumber" asp-route-q="@Model.Search" class="btn btn-sm btn-link">Discard</a>
                <button type="submit" class="btn btn-sm btn-primary"><partial name="_Icon" model='"check"' /> Save home stock</button>
            </div>
        </div>
    }
</form>
<partial name="_Pager" model="Model.Skus.ToPager(Model.Search)" />
