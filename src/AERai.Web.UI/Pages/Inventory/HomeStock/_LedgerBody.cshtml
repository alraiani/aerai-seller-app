@using System.Globalization
@using AERai.Web.Application.Inventory
@using AERai.Web.Domain.Core
@model AERai.Web.UI.Pages.Inventory.HomeStock.LedgerModel
@{
    var en = CultureInfo.GetCultureInfo("en-US");
    var grouped = Model.View == HomeStockLedgerView.ByMovement;
    var count = grouped ? Model.Groups.Sum(g => g.EntryCount) : Model.Entries.TotalCount;
    var empty = grouped ? Model.Groups.Count == 0 : Model.Entries.Items.Count == 0;
    // Operators get a tick-box column first (bulk reason) and an actions column last.
    var lead = Model.CanEdit ? 1 : 0;
    var columns = Model.CanEdit ? 10 : 8;
    var editable = grouped ? Model.Groups.Any(g => g.Entries.Any(e => e.CanEdit)) : Model.Entries.Items.Any(e => e.CanEdit);

    // View links keep every filter, so switching views never loses them.
    string ViewLink(HomeStockLedgerView view) => Url.Page("Ledger", new
    {
        q = Model.Search,
        sku = Model.Sku,
        family = Model.FamilyId,
        type = Model.Type,
        from = Model.From?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture),
        to = Model.To?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture),
        view = view == HomeStockLedgerView.ByMovement ? null : view.ToString(),
    })!;
}

<partial name="_InventoryNav" model="new AERai.Web.UI.Models.InventoryNavModel(AERai.Web.UI.Models.InventorySection.Ledger, Model.FamilyId)" />

@* ---------- Filters ---------- *@
<div class="list-toolbar mb-3">
    <form method="get" class="filters" data-autosubmit-form role="search">
        <div class="search-box">
            <partial name="_Icon" model='"search"' />
            <input type="search" name="q" value="@Model.Search" class="form-control form-control-sm" placeholder="Search SKU, name, reference, note…" aria-label="Search the ledger" />
        </div>
        @if (Model.Sku is not null)
        {
            <input type="hidden" name="sku" value="@Model.Sku" />
        }
        <select name="family" class="form-select form-select-sm" aria-label="Family">
            <option value="">All families</option>
            @foreach (var f in Model.Families)
            {
                <option value="@f.Id" selected="@(Model.FamilyId == f.Id)">@f.Name</option>
            }
        </select>
        <select name="type" class="form-select form-select-sm" aria-label="Movement type">
            <option value="">All movements</option>
            @foreach (var type in Enum.GetValues<HomeStockMovementType>())
            {
                <option value="@type" selected="@(Model.Type == type)">@AERai.Web.UI.Pages.Inventory.HomeStock.LedgerModel.Label(type)</option>
            }
        </select>
        <input type="date" name="from" value="@Model.From?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" class="form-control form-control-sm date-filter" aria-label="From date" data-autosubmit />
        @if (Model.ViewParam is { } viewParam)
        {
            <input type="hidden" name="view" value="@viewParam" />
        }
        <input type="date" name="to" value="@Model.To?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" class="form-control form-control-sm date-filter" aria-label="To date" data-autosubmit />
        <button type="submit" class="btn btn-sm btn-soft js-hide">Apply</button>
        @if (Model.IsFiltered)
        {
            <a asp-page="Ledger" asp-route-view="@Model.ViewParam" class="btn btn-sm btn-link">Clear filters</a>
        }
    </form>
</div>

<div class="card">
    <div class="card-toolbar">
        <span class="card-toolbar-title list-count">
            <span class="text-nowrap">@count.ToString("N0", en) entr@(count == 1 ? "y" : "ies")</span>
            <span class="text-muted-token fw-normal">
                @(Model.Sku is { } onlySku ? $"for {onlySku} " : "")in @Model.Marketplace.Name · times in @Model.Marketplace.TimeZoneId
            </span>
            <partial name="_Tip" model='"Every unit that came into or went out of home stock. Each SKU’s entries add up to its home stock; Balance is the SKU’s count right after the entry. Edits on the Worksheet, Edit page, bulk page, and uploads appear as count corrections. Mistakes are reversed, never deleted."' />
        </span>
        <div class="card-toolbar-group no-print">
            <nav class="segmented segmented-sm" aria-label="How to list entries">
                <a href="@ViewLink(HomeStockLedgerView.ByMovement)" class="@(grouped ? "active" : "")">By movement</a>
                <a href="@ViewLink(HomeStockLedgerView.Entries)" class="@(grouped ? "" : "active")">All entries</a>
            </nav>
            @if (grouped && Model.Groups.Count > 1)
            {
                <div class="expand-controls d-flex gap-2">
                    <button type="button" class="btn btn-sm btn-soft" data-expand-all="true">Expand all</button>
                    <button type="button" class="btn btn-sm btn-soft" data-expand-all="false">Collapse all</button>
                </div>
            }
            @if (Model.CanEdit)
            {
                <a asp-route-log="true" asp-route-sku="@Model.Sku" asp-route-view="@Model.ViewParam" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#log-dialog"><partial name="_Icon" model='"plus"' /> Log movement</a>
            }
        </div>
    </div>

    @if (empty)
    {
        <div class="empty-state">
            <div class="empty-title">@(Model.IsFiltered ? "No entries match" : "No home-stock movements yet")</div>
            <div class="empty-detail">@(Model.IsFiltered ? "Try a different search, family, type, or dates." : "Log incoming shipments from your supplier and outgoing shipments to Amazon here. Home-stock edits are logged automatically.")</div>
        </div>
    }
    else
    {
        @if (Model.CanEdit && editable)
        {
            @* Tick entries, or a whole movement with its group's box; the boxes belong to this form through form="…". *@
            <form method="post" asp-page="Ledger" asp-page-handler="Reason" asp-all-route-data="@Model.ListRouteValues()" id="ledger-bulk-form"
                  class="bulk-bar bulk-bar-row no-print" data-bulk-bar data-bulk-noun="row"
                  data-confirm="Set the reason on the ticked rows? Each change is recorded as a correction; the originals stay in the history.">
                <span class="bulk-count" data-bulk-count>Tick rows, or a whole movement, to set their reason at once.</span>
                <select name="reasonType" class="form-select form-select-sm bulk-input" aria-label="Movement to set on the ticked rows" data-bulk-button>
                    <option value="">Keep each movement</option>
                    @foreach (var (type, typeLabel) in LedgerModel.LoggableTypes)
                    {
                        <option value="@type">@typeLabel</option>
                    }
                </select>
                <input type="text" name="reasonNote" class="form-control form-control-sm bulk-input" maxlength="@HomeStockLedgerService.MaxNoteLength"
                       placeholder="Note (blank keeps each note)" aria-label="Note to set on the ticked rows" autocomplete="off" data-bulk-button />
                <button type="submit" class="btn btn-sm btn-soft" data-bulk-button><partial name="_Icon" model='"check"' /> Set reason</button>
            </form>
        }
        <div class="table-responsive">
            <table class="table data-table ledger-table align-middle mb-0 @(grouped ? "group-table" : "")">
                <thead>
                    <tr>
                        @if (Model.CanEdit)
                        {
                            <th class="select-col"><input type="checkbox" class="form-check-input" data-select-all aria-label="Select every row that can be edited" /></th>
                        }
                        @if (grouped)
                        {
                            <th class="toggle-col"><span class="visually-hidden">Expand</span></th>
                        }
                        <th>When</th>
                        <th>SKU</th>
                        <th>Movement</th>
                        <th class="text-end">Units</th>
                        <th class="text-end">Balance</th>
                        <th>Reference / note</th>
                        <th>Logged by</th>
                        @if (Model.CanEdit)
                        {
                            <th class="text-end no-print"><span class="visually-hidden">Actions</span></th>
                        }
                    </tr>
                </thead>
                @if (grouped)
                {
                    @* One group per kind of movement; a lone group (one type, or one SKU with one kind) opens at once,
                       and so does the group of the entry being edited. *@
                    foreach (var group in Model.Groups)
                    {
                        var open = Model.Groups.Count == 1 || group.Entries.Any(e => e.Id == Model.EditId);
                        var groupId = $"movement-{group.Type}";
                        var label = LedgerModel.Label(group.Type);
                        <tbody class="order-group @(open ? "is-expanded" : "")" id="@groupId">
                            <tr class="group-row">
                                @if (Model.CanEdit)
                                {
                                    <td class="select-col">
                                        @if (group.Entries.Any(e => e.CanEdit))
                                        {
                                            <input type="checkbox" class="form-check-input" data-select-group aria-label="Select every @label row" />
                                        }
                                    </td>
                                }
                                <td class="toggle-col">
                                    <button type="button" class="btn btn-sm btn-icon group-toggle" data-expand-row aria-expanded="@(open ? "true" : "false")" aria-controls="@groupId"
                                            aria-label="Show the @label entries">
                                        <partial name="_Icon" model='"chevron-down"' />
                                    </button>
                                </td>
                                <td colspan="3">
                                    <span class="@LedgerModel.Pill(group.Type)">@label</span>
                                    <span class="cell-sub ms-2">
                                        @group.EntryCount.ToString("N0", en) entr@(group.EntryCount == 1 ? "y" : "ies") · @group.SkuCount.ToString("N0", en) SKU@(group.SkuCount == 1 ? "" : "s") · latest @Model.Local(group.LatestAt).ToString("MMM d, yyyy", en)
                                    </span>
                                </td>
                                <td class="text-end">
                                    <span class="ledger-units fw-semibold @(group.NetUnits > 0 ? "in" : "out")">@group.NetUnits.ToString("+#,0;−#,0;0", en)</span>
                                    @if (group.UnitsIn > 0 && group.UnitsOut < 0)
                                    {
                                        <div class="cell-sub">@group.UnitsIn.ToString("+#,0", en) / @group.UnitsOut.ToString("−#,0;−#,0", en)</div>
                                    }
                                </td>
                                <td colspan="@(columns - 5 - lead)" class="text-end">
                                    <button type="button" class="btn btn-sm btn-soft no-print" data-print-group="@groupId"
                                            data-bs-toggle="tooltip" data-bs-title="Print only the @label entries"><partial name="_Icon" model='"printer"' /> Print</button>
                                </td>
                            </tr>
                            @foreach (var e in group.Entries)
                            {
                                <partial name="_LedgerEntryRow" model="(Model, e, true)" />
                            }
                            @if (group.IsCapped)
                            {
                                <tr class="group-child">
                                    @if (Model.CanEdit)
                                    {
                                        <td class="select-col"></td>
                                    }
                                    <td class="toggle-col"></td>
                                    <td colspan="@(columns - 1 - lead)" class="cell-sub">
                                        Showing the newest @group.Entries.Count.ToString("N0", en) of @group.EntryCount.ToString("N0", en).
                                        <a href="@Model.AllEntriesLink(group.Type)">See every @label entry</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    }
                }
                else
                {
                    <tbody>
                    @foreach (var e in Model.Entries.Items)
                    {
                        <partial name="_LedgerEntryRow" model="(Model, e, false)" />
                    }
                    </tbody>
                }
            </table>
        </div>
    }
</div>
@if (!grouped)
{
    <partial name="_Pager" model="Model.Entries.ToPager(Model.Search, Model.PagerFilters)" />
}

@if (Model.CanEdit)
{
    <div class="modal fade" id="log-dialog" tabindex="-1" aria-labelledby="log-title" aria-hidden="true" data-open-on-load="@(Model.OpenLog ? "true" : null)" data-open-param="log">
        <div class="modal-dialog modal-dialog-centered">
            <form method="post" asp-page-handler="Log" asp-route-sku="@Model.Sku" asp-route-family="@Model.FamilyId" asp-route-view="@Model.ViewParam" class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title h6" id="log-title">Log a home-stock movement</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div asp-validation-summary="All" class="alert alert-danger py-2"></div>
                    <div class="mb-3">
                        <label asp-for="Input.Type" class="form-label">Movement</label>
                        <select asp-for="Input.Type" class="form-select">
                            @foreach (var (type, label) in AERai.Web.UI.Pages.Inventory.HomeStock.LedgerModel.LoggableTypes)
                            {
                                <option value="@type">@label</option>
                            }
                        </select>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-7">
                            <label asp-for="Input.Sku" class="form-label">SKU</label>
                            <input asp-for="Input.Sku" class="form-control" autocomplete="off" />
                        </div>
                        <div class="col-5">
                            <label asp-for="Input.Quantity" class="form-label">Units</label>
                            <input asp-for="Input.Quantity" type="number" step="1" class="form-control text-end" />
                        </div>
                    </div>
                    <div class="form-text mb-3">Received and shipped: how many units. Count correction: the new counted total. Other: + to add, − to remove.</div>
                    <div class="mb-3">
                        <label asp-for="Input.OccurredAt" class="form-label">When (@Model.Marketplace.TimeZoneId)</label>
                        <input asp-for="Input.OccurredAt" type="datetime-local" step="60" asp-format="{0:yyyy-MM-ddTHH:mm}" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="Input.Reference" class="form-label">Reference <span class="text-muted-token">(PO, FBA shipment id…)</span></label>
                        <input asp-for="Input.Reference" class="form-control" />
                    </div>
                    <div>
                        <label asp-for="Input.Note" class="form-label">Note <span class="text-muted-token">(required for Other)</span></label>
                        <textarea asp-for="Input.Note" rows="2" class="form-control"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-link" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm btn-primary"><partial name="_Icon" model='"check"' /> Log movement</button>
                </div>
            </form>
        </div>
    </div>
}
