@using System.Globalization
@using AERai.Web.UI.Pages.Inventory.HomeStock
@model (LedgerModel Page, AERai.Web.Application.Inventory.HomeStockLedgerEntry Entry, bool Grouped)
@* One ledger entry, shared by the All entries list and the By movement groups (where it is a child row
   under its group's header, after an empty toggle column). *@
@{
    var en = CultureInfo.GetCultureInfo("en-US");
    var ledger = Model.Page;
    var e = Model.Entry;
    var when = ledger.Local(e.OccurredAt);
    var css = (Model.Grouped ? "group-child " : "") + (e.ReversedById is not null ? "ledger-reversed" : "");
}
<tr class="@css">
    @if (Model.Grouped)
    {
        <td class="toggle-col"></td>
    }
    <td class="ledger-when">
        <div>@when.ToString("MMM d, yyyy", en)</div>
        <div class="cell-sub">@when.ToString("h:mm tt", en)</div>
    </td>
    <td class="@ColorFormat.CssClass(e.Color)">
        <a asp-page="Ledger" asp-route-sku="@e.Sku" asp-route-view="@ledger.ViewParam" class="d-inline-flex align-items-center gap-2 text-decoration-none"><span class="swatch @(e.Color is null ? "swatch-none" : "")"></span><span class="fw-semibold">@e.Sku</span></a>
        @if (e.Title is { } title)
        {
            <div class="cell-sub cell-truncate" title="@title">@title</div>
        }
    </td>
    <td>
        <span class="@LedgerModel.Pill(e.Type)">@LedgerModel.Label(e.Type)</span>
        @if (e.ReversesId is { } reverses)
        {
            <div class="cell-sub">reverses #@reverses</div>
        }
        else if (e.ReversedById is { } reversedBy)
        {
            <div class="cell-sub">reversed by #@reversedBy</div>
        }
    </td>
    <td class="text-end"><span class="ledger-units @(e.Units > 0 ? "in" : "out")">@e.Units.ToString("+#,0;−#,0", en)</span></td>
    <td class="text-end fw-semibold">@e.BalanceAfter.ToString("N0", en)</td>
    <td class="ledger-note">
        @if (e.Reference is { } reference)
        {
            <div class="fw-semibold">@reference</div>
        }
        @if (e.Note is { } note)
        {
            <div class="cell-sub">@note</div>
        }
        @if (e.Reference is null && e.Note is null)
        {
            <span class="cell-sub">—</span>
        }
    </td>
    <td>
        <div class="cell-sub">@e.CreatedBy</div>
        <div class="cell-sub">#@e.Id · @ledger.Local(e.CreatedAt).ToString("MMM d, h:mm tt", en)</div>
    </td>
    @if (ledger.CanEdit)
    {
        <td class="text-end no-print">
            @if (e.CanReverse)
            {
                <form method="post" asp-page="Ledger" asp-page-handler="Reverse" asp-route-id="@e.Id" asp-route-sku="@ledger.Sku" asp-route-family="@ledger.FamilyId" asp-route-view="@ledger.ViewParam" asp-route-p="@ledger.PageNumber"
                      data-confirm="Reverse entry #@e.Id? A new entry will undo its @Math.Abs(e.Units).ToString("N0", en) units.">
                    <button type="submit" class="btn btn-sm btn-soft btn-icon" aria-label="Reverse entry @e.Id"
                            data-bs-toggle="tooltip" data-bs-title="Undo this entry with a reversing entry"><partial name="_Icon" model='"rewind"' /></button>
                </form>
            }
        </td>
    }
</tr>
