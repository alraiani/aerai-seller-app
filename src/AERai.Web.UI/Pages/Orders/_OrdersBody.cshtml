@using System.Globalization
@using AERai.Web.Application.Orders
@model AERai.Web.UI.Pages.Orders.IndexModel
@{
    var t = Model.List.Totals;
    var currency = Model.Marketplace.Currency;
    var rows = Model.List.Orders.Items;
}

@* ---------- Totals for what the search and filters select (all pages) ---------- *@
<div class="row g-3 mb-3">
    <div class="col-6 col-xl-3">
        <a class="card tile h-100" href="@Model.SortLink(OrderSort.Purchased)">
            <div class="kpi">
                <div class="kpi-label">Orders <partial name="_Tip" model='"Orders the search and filters select (every page), cancelled ones included. Click to sort by purchase date."' /></div>
                <div class="kpi-value">@t.Orders.ToString("N0", CultureInfo.InvariantCulture)</div>
                <div class="kpi-foot">@(t.Cancelled == 0 ? "None cancelled" : $"{t.Cancelled.ToString("N0", CultureInfo.InvariantCulture)} cancelled")</div>
            </div>
        </a>
    </div>
    <div class="col-6 col-xl-3">
        <a class="card tile h-100" href="@Model.SortLink(OrderSort.Units)">
            <div class="kpi">
                <div class="kpi-label">Units <partial name="_Tip" model='"Units on the orders listed, not counting cancelled orders. Click to sort by units."' /></div>
                <div class="kpi-value">@t.Units.ToString("N0", CultureInfo.InvariantCulture)</div>
                <div class="kpi-foot">@(t.Orders - t.Cancelled > 0 ? $"{((decimal)t.Units / (t.Orders - t.Cancelled)).ToString("0.#", CultureInfo.InvariantCulture)} per order" : "No orders")</div>
            </div>
        </a>
    </div>
    <div class="col-6 col-xl-3">
        <a class="card tile h-100" href="@Model.SortLink(OrderSort.Sales)">
            <div class="kpi">
                <div class="kpi-label">Sales <partial name="_Tip" model='"Item prices on the orders listed, before Amazon’s fees, not counting cancelled orders. Pending orders are included. Click to sort by sales."' /></div>
                <div class="kpi-value">@DashboardFormat.Money(t.Sales, currency)</div>
                <div class="kpi-foot">in @currency</div>
            </div>
        </a>
    </div>
    <div class="col-6 col-xl-3">
        <a class="card tile h-100" href="@Model.SortLink(OrderSort.Sales)">
            <div class="kpi">
                <div class="kpi-label">Avg order value <partial name="_Tip" model='"Sales divided by the orders that weren’t cancelled. Click to sort by sales."' /></div>
                <div class="kpi-value">@(t.AverageOrderValue is { } aov ? DashboardFormat.Price(aov, currency) : "—")</div>
                <div class="kpi-foot">per order</div>
            </div>
        </a>
    </div>
</div>

@* ---------- Search + purchase dates + status ---------- *@
<div class="list-toolbar mb-3">
    <form method="get" class="filters" data-autosubmit-form role="search">
        @if (Model.Sort != OrderSort.Purchased)
        {
            <input type="hidden" name="sort" value="@Model.Sort" />
        }
        @if (Model.Descending)
        {
            <input type="hidden" name="desc" value="true" />
        }
        <div class="search-box">
            <partial name="_Icon" model='"search"' />
            <input type="search" name="q" value="@Model.Search" class="form-control form-control-sm" placeholder="Search order, SKU, ASIN, title…" aria-label="Search orders" />
        </div>
        <label class="filter-label" for="order-from">Purchased</label>
        <input type="date" id="order-from" name="from" value="@Model.From?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" class="form-control form-control-sm date-filter" aria-label="Purchased on or after" data-autosubmit />
        <span class="text-muted-token" aria-hidden="true">–</span>
        <input type="date" name="to" value="@Model.To?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" class="form-control form-control-sm date-filter" aria-label="Purchased on or before" data-autosubmit />
        @if (Model.List.Statuses.Count > 1 || !string.IsNullOrWhiteSpace(Model.Status))
        {
            <select name="status" class="form-select form-select-sm" aria-label="Status">
                <option value="">Any status</option>
                @foreach (var s in Model.List.Statuses)
                {
                    <option value="@s" selected="@(string.Equals(Model.Status, s, StringComparison.OrdinalIgnoreCase))">@s</option>
                }
            </select>
        }
        <button type="submit" class="btn btn-sm btn-soft js-hide">Apply</button>
        @if (Model.IsFiltered)
        {
            <a asp-page="Index" class="btn btn-sm btn-link">Clear filters</a>
        }
    </form>
</div>

@* ---------- Order list ---------- *@
<div class="card">
    <div class="card-toolbar">
        <span class="card-toolbar-title list-count">
            <span class="text-nowrap">@Model.List.Orders.TotalCount.ToString("N0", CultureInfo.InvariantCulture) order@(Model.List.Orders.TotalCount == 1 ? "" : "s")</span>
            <span class="text-muted-token fw-normal">in @Model.Marketplace.Name · times in @Model.Marketplace.Code local time</span>
            <partial name="_Tip" model='"One row per Amazon order. Expand one to see its items and what Amazon paid out for it. Paid out adds up the order’s lines in every settlement so far (a sale and a later refund are often in different ones); an order Amazon is still holding shows when it will be released. Est. profit is that payout less the cost of goods set on Products, so it shows once the order is paid out and every item has a cost."' />
        </span>
        @if (rows.Count > 0)
        {
            <div class="card-toolbar-group">
                <span class="expand-controls">
                    <button type="button" class="btn btn-sm btn-soft" data-expand-all="true">Expand all</button>
                    <button type="button" class="btn btn-sm btn-soft" data-expand-all="false">Collapse all</button>
                </span>
                <a href="@Model.ExportLink()" class="btn btn-sm btn-soft"
                   data-bs-toggle="tooltip" data-bs-title="Download the orders listed (every page, up to @OrderService.MaxExportRows.ToString("N0", CultureInfo.InvariantCulture) item rows) as a CSV, one row per item."><partial name="_Icon" model='"download"' /> CSV</a>
            </div>
        }
    </div>
    @if (rows.Count == 0)
    {
        <div class="empty-state">
            @if (Model.IsFiltered)
            {
                <div class="empty-title">No orders match</div>
                <div class="empty-detail">Try a different search, period, or status.</div>
                <a asp-page="Index" class="btn btn-sm btn-soft">Clear filters</a>
            }
            else
            {
                <div class="empty-title">No orders yet</div>
                <div class="empty-detail">Orders appear once the Orders sync runs for @Model.Marketplace.Name, or after you import an orders file.</div>
                <a asp-page="/Tools/Schedules/Index" class="btn btn-sm btn-soft"><partial name="_Icon" model='"plug"' /> Amazon sync</a>
            }
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table data-table group-table order-table align-middle mb-0">
                <thead>
                    <tr>
                        <th class="toggle-col"><span class="visually-hidden">Expand</span></th>
                        <th>Order</th>
                        <th><a href="@Model.SortLink(OrderSort.Purchased)" class="sort-link">Purchased @Model.SortArrow(OrderSort.Purchased)</a></th>
                        <th>Status</th>
                        <th class="text-end"><a href="@Model.SortLink(OrderSort.Units)" class="sort-link">Units @Model.SortArrow(OrderSort.Units)</a></th>
                        <th class="text-end"><a href="@Model.SortLink(OrderSort.Sales)" class="sort-link">Sales @Model.SortArrow(OrderSort.Sales)</a></th>
                        <th class="text-end">Paid out <partial name="_Tip" model='"What Amazon paid for the order so far: sales less fees and refunds, over every settlement with lines for it."' /></th>
                        <th class="text-end">Est. profit <partial name="_Tip" model='"Paid out less the cost of goods (units × the SKU’s current cost on Products)."' /></th>
                    </tr>
                </thead>
                @for (var i = 0; i < rows.Count; i++)
                {
                    var row = rows[i];
                    var o = row.Order;
                    var money = o.Currency ?? currency;
                    var groupId = $"order-{i}";
                    var cancelled = OrderStatuses.IsCancelled(o.OrderStatus);
                    <tbody class="order-group" id="@groupId">
                        <tr class="group-row">
                            <td class="toggle-col">
                                <button type="button" class="btn btn-sm btn-icon group-toggle" data-expand-row aria-expanded="false" aria-controls="@groupId"
                                        aria-label="Show the items of order @o.AmazonOrderId">
                                    <partial name="_Icon" model='"chevron-down"' />
                                </button>
                            </td>
                            <td>
                                <div class="fw-semibold text-nowrap">@o.AmazonOrderId</div>
                                <div class="cell-sub">@o.LineCount.ToString("N0", CultureInfo.InvariantCulture) item@(o.LineCount == 1 ? "" : "s")</div>
                            </td>
                            <td class="text-nowrap">@OrderFormat.Purchased(o.PurchaseDate, Model.Zone)</td>
                            <td><span class="@OrderFormat.StatusPill(o.OrderStatus)">@o.OrderStatus</span></td>
                            <td class="text-end money">@o.Units.ToString("N0", CultureInfo.InvariantCulture)</td>
                            <td class="text-end money @(cancelled ? "text-muted-token" : "")">@SettlementFormat.Money(o.OrderTotal, money)</td>
                            <td class="text-end money text-nowrap">
                                @if (row.Payout is { } paid)
                                {
                                    <span class="fw-semibold @SettlementFormat.AmountClass(paid.Net)">@SettlementFormat.Money(paid.Net, money)</span>
                                }
                                else if (!cancelled && row.Deferral is { } deferral)
                                {
                                    @* Amazon holds the payout (its delivery-date policy); the amount is what it will pay out. *@
                                    <span class="pill pill-info has-detail" title="@SettlementFormat.DeferralReasonTitle(deferral.DeferralReason): @SettlementFormat.Money(deferral.Amount, deferral.Currency ?? money) to be paid out">
                                        Deferred until @(SettlementFormat.Day(deferral.MaturityDate, Model.Zone) ?? "unknown")
                                    </span>
                                }
                                else if (!cancelled)
                                {
                                    <span class="pill pill-info">Not paid out</span>
                                }
                            </td>
                            <td class="text-end money text-nowrap">
                                @switch (row.Profit.State)
                                {
                                    case OrderProfitState.Estimated:
                                        <span class="fw-semibold @SettlementFormat.AmountClass(row.Profit.Profit ?? 0)">@SettlementFormat.Money(row.Profit.Profit ?? 0, money)</span>
                                        break;
                                    case OrderProfitState.CostMissing:
                                        <span class="pill pill-warn has-detail" title="At least one item has no cost of goods in @Model.Marketplace.Name">Cost missing</span>
                                        break;
                                    case OrderProfitState.NotPaidOut:
                                        <span class="text-muted-token">After payout</span>
                                        break;
                                }
                            </td>
                        </tr>
                        @foreach (var item in row.Items)
                        {
                            <tr class="group-child">
                                <td></td>
                                <td colspan="3"><partial name="_ProductCell" model="new ProductCellModel(item.Sku, item.Asin, item.Title, item.Family, item.ImagePath, null)" /></td>
                                <td class="text-end money">@item.Quantity.ToString("N0", CultureInfo.InvariantCulture)</td>
                                <td class="text-end money">@SettlementFormat.Money(item.ItemPrice, money)</td>
                                <td class="text-end text-muted-token text-nowrap" colspan="2">
                                    @if (item.UnitCost is { } cost)
                                    {
                                        <span>Cost @DashboardFormat.Price(cost, money) each</span>
                                    }
                                    else
                                    {
                                        <a asp-page="/Products/Index" asp-route-q="@item.Sku" class="cell-sub text-warn">No cost set</a>
                                    }
                                </td>
                            </tr>
                        }
                        @if (row.Payout is { } payout)
                        {
                            <tr class="group-child">
                                <td></td>
                                <td colspan="7">
                                    <div class="order-payout">
                                        <partial name="/Pages/Settlements/_SettlementBreakdown.cshtml" model="(payout.Sales, payout.Refunds, payout.Expenses, payout.Reserve, payout.Net, (string?)money)" />
                                        @if (row.Profit.CostOfGoods is { } cogs && row.Profit.Profit is { } profit)
                                        {
                                            <dl class="amount-breakdown">
                                                <div><dt>Cost of goods</dt><dd class="amount-neg">@SettlementFormat.Money(-cogs, money)</dd></div>
                                                <div class="amount-breakdown-total"><dt>Est. profit</dt><dd class="@SettlementFormat.AmountClass(profit)">@SettlementFormat.Money(profit, money)</dd></div>
                                            </dl>
                                        }
                                        <div class="cell-sub">
                                            Paid in
                                            @for (var s = 0; s < payout.SettlementIds.Count; s++)
                                            {
                                                @(s == 0 ? "" : ", ")
                                                if (Model.SettlementsListedUnder is null)
                                                {
                                                    <a asp-page="/Settlements/Summary" asp-route-id="@payout.SettlementIds[s]">settlement @payout.SettlementIds[s]</a>
                                                }
                                                else
                                                {
                                                    <span>settlement @payout.SettlementIds[s]</span>
                                                }
                                            }
                                            @if (Model.SettlementsListedUnder is { } home)
                                            {
                                                <span>· listed under @home.Name</span>
                                            }
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                }
            </table>
        </div>
    }
</div>
<partial name="_Pager" model="Model.List.Orders.ToPager(Model.Search, Model.CurrentFilters())" />
