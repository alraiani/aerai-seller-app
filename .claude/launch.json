        "--urls",
        "http://localhost:5043"
      ],
      "port": 5043
    },
    {
      "name": "aerai-web-alt",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "web/src/AERai.Web.UI",
        "--launch-profile",
        "http",
        "--no-build",
        "--urls",
        "http://localhost:5044"
      ],
      "port": 5044
    }
  ]
