{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "aerai-web",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "src/AERai.Web.UI",
        "--launch-profile",
        "http"
      ],
      "port": 5042
    },
    {
      "name": "aerai-web-review",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "src/AERai.Web.UI",
        "--launch-profile",
        "http",
        "--no-build",
        "--urls",
        "http://localhost:5043"
      ],
      "port": 5043
    },
    {
      "name": "aerai-web-alt",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "src/AERai.Web.UI",
        "--launch-profile",
        "http",
        "--no-build",
        "--urls",
        "http://localhost:5044"
      ],
      "port": 5044
    },
    {
      "name": "aerai-web-sim",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "src/AERai.Web.UI",
        "--launch-profile",
        "http",
        "--urls",
        "http://localhost:5045",
        "--SpApi:Mode=Simulated",
        "--AmazonAds:Mode=Simulated",
        "--Email:Provider=Smtp"
      ],
      "port": 5045
    }
  ]
}
